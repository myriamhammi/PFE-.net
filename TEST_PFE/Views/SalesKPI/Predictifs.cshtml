@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>KPIs Prédictifs</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-dark: #1e1e28;
            --secondary-dark: #333333;
            --accent: #ffe600;
            --accent-dark: #e6d600;
            --light: #ffffff;
            --muted: #cccccc;
            --neutral: #999999;
            --card-shadow: 0 8px 20px rgba(0,0,0,0.12);
            --transition: all 0.3s ease-in-out;
        }

        body {
            background-color: var(--primary-dark);
            font-family: 'Segoe UI', sans-serif;
            color: var(--light);
            margin: 0;
            padding-top: 80px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background-color: var(--secondary-dark);
            box-shadow: var(--card-shadow);
            border-bottom: 2px solid var(--accent);
        }

        .navbar-brand {
            color: var(--accent);
            font-weight: bold;
            font-size: 1.5rem;
            transition: var(--transition);
        }

            .navbar-brand:hover {
                color: var(--accent-dark);
            }

        .nav-link {
            color: var(--muted);
            font-weight: 600;
            transition: var(--transition);
            position: relative;
            padding: 0.5rem 1rem;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background-color: var(--accent);
                transition: var(--transition);
                transform: translateX(-50%);
            }

            .nav-link:hover::after,
            .nav-link.active::after {
                width: 80%;
            }

            .nav-link:hover,
            .nav-link.active {
                color: var(--accent);
            }

        .btn-profile {
            background-color: transparent;
            color: var(--accent);
            font-weight: bold;
            border: 2px solid var(--accent);
            border-radius: 20px;
            padding: 0.4rem 1.2rem;
            transition: var(--transition);
        }

            .btn-profile:hover {
                background-color: var(--accent);
                color: var(--primary-dark);
            }

        header {
            background-color: var(--secondary-dark);
            color: var(--light);
            padding: 3rem 0;
            text-align: center;
            border-bottom: 3px solid var(--accent);
            margin-bottom: 2rem;
        }

            header h1 {
                font-size: 2.5rem;
            }

        main {
            padding: 3rem 6vw;
            background-color: var(--primary-dark);
            flex: 1;
        }

        h2 {
            font-weight: bold;
            margin-bottom: 2rem;
            text-align: center;
        }

        .card {
            border: 1px solid var(--accent);
            border-radius: 15px;
            background-color: var(--secondary-dark);
            box-shadow: var(--card-shadow);
            transition: var(--transition);
            cursor: pointer;
            overflow: hidden;
        }

            .card:hover {
                transform: scale(1.02);
                box-shadow: 0 12px 24px rgba(0,0,0,0.12);
            }

        .card-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--light);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .card-title i {
                background-color: var(--ey-yellow);
                padding: 0.5rem;
                border-radius: 10px;
                color: var(--dark-bg);
            }

        .card-text {
            color: var(--muted);
            margin: 1rem 0;
            line-height: 1.6;
        }

        .btn-ffe600 {
            background-color: var(--accent);
            color: var(--primary-dark);
            border: none;
            font-weight: 600;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

            .btn-ffe600:hover {
                background-color: var(--ey-yellow-dark);
            }

        footer.footer {
            background-color: var(--dark-bg);
            color: var(--muted-gray);
            text-align: center;
            padding: 1rem;
        }

        .btn-social {
            color: var(--muted-gray);
            font-size: 1.3rem;
            margin: 0 0.5rem;
        }

            .btn-social:hover {
                color: var(--ey-yellow);
            }

        .kpi-card {
            border-radius: 12px;
            box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
            padding: 1.5rem;
            background: white;
            text-align: center;
        }

        .kpi-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.3rem;
        }

        .kpi-label {
            font-weight: 600;
            color: #666;
        }

        .kpi-card {
            border-radius: 12px;
            box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
            padding: 1.5rem;
            background: white;
            text-align: center;
            transition: background-color 0.3s ease;
            cursor: default;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .kpi-value {
            font-size: 2.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .kpi-label {
            font-weight: 600;
            color: #555;
            font-size: 1rem;
        }

        .kpi-icon {
            font-size: 1.8rem;
        }

        /* Couleurs selon niveau */
        .kpi-green {
            background-color: #d4edda;
            color: #155724;
        }

        .kpi-yellow {
            background-color: #fff3cd;
            color: #856404;
        }

        .kpi-red {
            background-color: #f8d7da;
            color: #721c24;
        }

        .kpi-affichage {
            margin-top: 20px; /* Ajustez la valeur selon ce que vous voulez */
        }

    </style>
</head>
<body style="min-height: 100vh; display: flex; flex-direction: column;">

    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container-fluid px-5">
            <a class="navbar-brand" href="/">BI 360°</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link active" href="/SalesKPI/Predictifs">KPIs</a></li>
                    <li class="nav-item"><a class="nav-link" href="/ETL/Upload">ETL</a></li>
                    <li class="nav-item"><a class="nav-link" href="/entities">CRM</a></li>
                    <li class="nav-item"><a class="nav-link" href="https://app.powerbi.com/reportEmbed?reportId=efef675d-ae63-4d35-aad1-3d13d206672b&autoAuth=true&ctid=604f1a96-cbe8-43f8-abbf-f8eaf5d85730">Dashboards</a></li>
                </ul>
                <button class="btn btn-profile">Myriam HAMMI</button>
            </div>
        </div>
    </nav>

    <header>
        <h1>Tableau de Bord Prédictif</h1>
    </header>

    <main style="flex: 1;" id="kpis">

        <div class="row gy-4">
            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card p-3 flex-fill" role="button" tabindex="0">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title"><i class="fas fa-chart-line"></i> Probabilité de gain</h3>
                        <p class="card-text">Estimation du taux de succès des opportunités selon leurs caractéristiques.</p>
                        <a href="/Prediction/gain_opp" class="btn btn-ffe600 mt-auto" title="Voir la prédiction de la probabilité de gain">
                            Voir la prédiction
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card p-3 flex-fill">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title"><i class="fas fa-euro-sign"></i> Montant total de la commande</h3>
                        <p class="card-text">Projection des ventes futures basée sur les données historiques et le pipeline.</p>
                        <a href="/Prediction/Sales_Total" class="btn btn-ffe600 mt-auto" title="Voir la prédiction du montant total de la commande">
                            Voir la prédiction
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card p-3 flex-fill">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title"><i class="fas fa-project-diagram"></i> Status de la commande</h3>
                        <p class="card-text">Anticipation des ruptures dans le processus commercial ou le suivi des leads.</p>
                        <a href="/Prediction/Order_status" class="btn btn-ffe600 mt-auto" title="Voir la prédiction du pipeline">
                            Voir la prédiction
                        </a>
                    </div>
                </div>
            </div>
        </div>


    </main>


    <footer style="background-color: var(--secondary-dark); color: var(--muted); padding: 20px 0; text-align: center; border-top: 2px solid var(--accent);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 text-lg-start">Copyright &copy; BI 360° 2024</div>
                <div class="col-lg-4 my-3 my-lg-0">
                    <a class="btn btn-social mx-2" href="#!" aria-label="Twitter" style="color: var(--accent); transition: var(--transition);"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-social mx-2" href="#!" aria-label="Facebook" style="color: var(--accent); transition: var(--transition);"><i class="fab fa-facebook-f"></i></a>
                    <a class="btn btn-social mx-2" href="#!" aria-label="LinkedIn" style="color: var(--accent); transition: var(--transition);"><i class="fab fa-linkedin-in"></i></a>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="text-decoration-none me-3" href="#!" style="color: var(--muted); transition: var(--transition);">Privacy Policy</a>
                    <a class="text-decoration-none" href="#!" style="color: var(--muted); transition: var(--transition);">Terms of Use</a>
                </div>
            </div>
        </div>
    </footer>




    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
