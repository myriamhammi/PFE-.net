@* @{
    ViewData["Title"] = "Prédiction ML";
    Layout = "~/Pages/Shared/_KPIsLayout.cshtml";
}

<h2>Faire une Prédiction</h2>

<div>
    <label for="modelSelect">Choisir un modèle :</label>
    <select id="modelSelect" class="form-control">
        <option value="rf">Random Forest</option>
        <option value="logreg">Régression Logistique</option>
    </select>
</div>

<br />

<div id="featuresContainer">
    <label>Paramètres d'entrée :</label>
    <div id="inputs">
        <!-- Champs générés dynamiquement -->
    </div>
    <button class="btn btn-secondary mt-2" onclick="addFeature()">Ajouter un paramètre</button>
</div>

<br />

<button class="btn btn-primary" onclick="predict()">Prédire</button>

<br />
<br />

<div id="resultContainer" style="display:none;">
    <h4>Résultat :</h4>
    <div id="predictionResult" class="alert alert-info"></div>
</div>

@section Scripts {
    <script>
         console.log("JS chargé !");
        

        function addFeature() {
            const inputDiv = document.createElement('div');
            inputDiv.className = "input-group mb-2";
            inputDiv.innerHTML = `
                <input type="number" step="any" class="form-control featureInput" placeholder="Valeur de paramètre" />
                <div class="input-group-append">
                    <button class="btn btn-danger" onclick="this.parentElement.parentElement.remove()">Supprimer</button>
                </div>`;
            document.getElementById('inputs').appendChild(inputDiv);
        }

              function predict() {
            console.log("Fonction predict appelée !");
            const model = document.getElementById('modelSelect').value;
            const inputs = Array.from(document.querySelectorAll('.featureInput'))
                                 .map(el => parseFloat(el.value))
                                 .filter(val => !isNaN(val));

            if (inputs.length === 0) {
                alert("Veuillez entrer au moins un paramètre valide.");
                return;
            }

            fetch(`/api/prediction/${model}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(inputs)
            })
                   .then(res => res.json())
        .then(data => {
            console.log("Réponse API :", data);
            document.getElementById('resultContainer').style.display = 'block';
            document.getElementById('predictionResult').innerText = "Valeur prédite : " + data.prediction;
        })

            .catch(err => {
                document.getElementById('resultContainer').style.display = 'block';
                document.getElementById('predictionResult').innerText = "Erreur : " + err;
            });
        }


        // Initialiser avec un champ
        window.onload = () => {
            addFeature();
        };
    </script>
} *@