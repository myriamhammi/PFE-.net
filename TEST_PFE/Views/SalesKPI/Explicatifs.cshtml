 *@

@{
    ViewData["Title"] = "KPIs Explicatifs";
    Layout = "~/Pages/Shared/_KPIsLayout.cshtml";
}

<section class="py-5 bg-white" style="min-height: 100vh;">
    <div class="container-fluid px-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-uppercase">KPIs Explicatifs</h2>
            <p class="text-muted">Indicateurs permettant de comprendre les causes des performances commerciales.</p>
        </div>

        <div class="row g-4">
            @{
                var kpisExplicatifs = new List<(string Titre, string Definition, string Icon)>
            {
            (
            "Taux de transformation par commercial",
            "% d'opportunités gagnées par commercial",
            "fa-user-check"
            ),
            (
            "Taux d'abandon par étape du pipeline",
            "% d'opportunités perdues à chaque étape",
            "fa-signal"
            ),
            (
            "Impact des promotions sur les ventes",
            "Variation du CA durant les campagnes",
            "fa-bullhorn"
            ),
            (
            "Répartition des ventes par canal",
            "Catégorisation des canaux : Digital, Téléphone, Email, Publicité, Évènementiel, Autre",
            "fa-diagram-project"
            )
            };
            }

            @foreach (var kpi in kpisExplicatifs)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 border-0 rounded-3 hover-shadow">
                        <div class="card-body d-flex align-items-start p-4">
                            <i class="fas @kpi.Icon fa-2x me-3" style="color: #FFE600;"></i>
                            <div>
                                <h5 class="card-title fw-semibold text-uppercase text-dark mb-2">@kpi.Titre</h5>
                                <p class="card-text text-muted mb-1">@kpi.Definition</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</section>
<!-- Custom Styles -->
<style>
    .hover-shadow:hover {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
    }

    .card-text {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
    }

    .text-primary {
        color: #333333 !important;
    }

    .text-muted {
        color: #6c757d;
    }
</style>