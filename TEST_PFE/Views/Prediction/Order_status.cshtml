@{
    ViewData["Title"] = "Sales Prediction Status";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-7xl mx-auto p-6 bg-gray-100 min-h-screen">

    <h1 class="text-3xl font-bold mb-4 text-gray-800">📊 Sales Prediction Dashboard</h1>
    <!-- Prediction Form -->
    <div class="bg-white p-6 rounded-xl shadow mt-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">🔮 Lancer une Prédiction</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input id="full_name" type="text" placeholder="Nom complet" class="p-2 border rounded-lg w-full" />
            <label for="Industry" class="block text-sm font-medium text-gray-700">🏭 Secteur</label>
            <select id="Industry" class="p-2 border rounded-lg w-full">
                <option value="">-- Choisir un secteur --</option>
                <option value="Healthcare">Healthcare</option>
                <option value="Finance">Finance</option>
                <option value="Retail">Retail</option>
                <option value="Technology">Technology</option>
            </select>

            <input id="Order_Total" type="number" placeholder="Montant total de la commande" class="p-2 border rounded-lg w-full" />
            <input id="delai_livraison_jours" type="number" placeholder="Délai de livraison (jours)" class="p-2 border rounded-lg w-full" />
            <input id="Order_Month" type="number" placeholder="Mois de commande (1-12)" class="p-2 border rounded-lg w-full" />
            <input id="Order_Weekday" type="number" placeholder="Jour de la semaine (0=dim, 6=sam)" class="p-2 border rounded-lg w-full" />
            <input id="Order_Quarter" type="number" placeholder="Trimestre (1-4)" class="p-2 border rounded-lg w-full" />
            <input id="nb_lignes_produits" type="number" placeholder="Nombre de lignes produits" class="p-2 border rounded-lg w-full" />
            <input id="quantite_totale" type="number" placeholder="Quantité totale" class="p-2 border rounded-lg w-full" />
            <input id="prix_unitaire_moyen" type="number" step="0.01" placeholder="Prix unitaire moyen" class="p-2 border rounded-lg w-full" />
            <input id="nb_produits_uniques" type="number" placeholder="Nombre de produits uniques" class="p-2 border rounded-lg w-full" />
            <input id="prix_total_recalcule" type="number" step="0.01" placeholder="Prix total recalculé" class="p-2 border rounded-lg w-full" />
            <input id="quantite_par_ligne" type="number" step="0.01" placeholder="Quantité par ligne" class="p-2 border rounded-lg w-full" />
            <input id="prix_moyen_par_ligne" type="number" step="0.01" placeholder="Prix moyen par ligne" class="p-2 border rounded-lg w-full" />
        </div>

        <button onclick="sendPrediction()"
                class="mt-4 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
            ⚙️ Prédire
        </button>

        <div id="predictionResult" class="mt-4 text-gray-800 font-medium"></div>
    </div>


    <!-- Client selector -->
    <div class="mb-6">
        <label for="clientSelect" class="block text-lg font-medium text-gray-700">👤 Select a client</label>
        <select id="clientSelect" class="mt-2 w-full p-2 border border-gray-300 rounded-lg">
            <option value="">-- Choose a client --</option>
        </select>
    </div>

    <!-- Pie chart -->
    <div class="mb-6 bg-white rounded-xl shadow p-4">
        <h2 class="text-xl font-semibold mb-2">📈 Global Prediction Stats</h2>
        <canvas id="globalChart" width="400" height="400"></canvas>
    </div>

    <!-- Latest predictions -->
    <div>
        <h2 class="text-xl font-semibold mb-2 text-gray-800">🕓 Recent Predictions</h2>
        <div id="recentPredictions" class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <!-- JS fills this -->
        </div>
    </div>
</div>

<script>


    async function fetchClients() {
        const res = await fetch("/api/prediction/clients");
        const clients = await res.json();
        const select = document.getElementById("clientSelect");
        clients.forEach(client => {
            const opt = document.createElement("option");
            opt.value = client;
            opt.innerText = client;
            select.appendChild(opt);
        });
    }

