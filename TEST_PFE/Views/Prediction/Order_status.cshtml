    //                 backgroundColor: ['#10b981', '#ef4444']
    //             }]
    //         }
    //     });
    // }

        let globalChartInstance = null;

    async function fetchGlobalStats() {
        try {
            const res = await fetch("/api/prediction/stats/overview");
            const raw = await res.text();
            console.log("RAW:", raw);

            const stats = JSON.parse(raw);
            console.log("Parsed stats:", stats);

            const ctx = document.getElementById('globalChart').getContext('2d');

            // Détruire l'ancien graphique s'il existe
            if (globalChartInstance !== null) {
                globalChartInstance.destroy();
            }

             // Créer un nouveau graphique
            globalChartInstance = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Validées', 'Annulées'],
                    datasets: [{
                        label: 'Statistiques Globales',
                        data: [stats.negatives, stats.positives],
                        backgroundColor: ['#10b981', '#ef4444']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            

           
        } catch (error) {
            console.error("Erreur lors de la récupération des statistiques :", error);
        }
    }

    // Lancer la mise à jour automatique au chargement
    window.addEventListener('load', () => {
        fetchGlobalStats(); // Chargement initial
        setInterval(fetchGlobalStats, 10000); // Rafraîchissement toutes les 10 secondes
    });



    async function fetchRecentPredictions() {
        const res = await fetch("/api/prediction/recent");

        if (!res.ok) {
            console.error("Erreur lors de la récupération des prédictions récentes");
            return;
        }

        const data = await res.json();
        console.log(data);  // Pour voir la structure réelle

        const container = document.getElementById("recentPredictions");
        container.innerHTML = "";

        data.forEach(item => {
            const fullName = item.full_name || "Nom inconnu";
            const industry = item.industry || "Industrie inconnue";
            const prediction = item.prediction;  // suppose 0 ou 1
            const prob = parseFloat(item.prob_class_1);
            const probability = (!isNaN(prob) && prob >= 0 && prob <= 1) ? Math.round(prob * 100) : "?";
            const timestamp = item.timestamp ? new Date(item.timestamp).toLocaleString() : "Date inconnue";

            const card = document.createElement("div");
            card.className = "bg-white p-4 rounded-xl shadow hover:scale-105 transition-transform duration-300";
            card.innerHTML = `
                <h3 class="text-lg font-bold">${fullName}</h3>
                <p class="text-sm text-gray-600">Secteur : ${industry}</p>
                <p class="mt-1 text-gray-800 font-semibold">
                    ${prediction === 1 ? '🚫 Annulée' : '✅ Validée'}
                </p>
                <div class="text-sm mt-1 text-gray-500">
                    Probabilité : ${probability}% d'annulation
                </div>
                <div class="text-xs mt-2 text-gray-400">Le ${timestamp}</div>
            `;
            container.appendChild(card);
        });
    }



           async function sendPrediction() {
        try {
            const body = {
                Full_Name: document.getElementById("full_name").value.trim(),
                Industry: document.getElementById("Industry").value.trim(),
                Order_Total: parseFloat(document.getElementById("Order_Total").value),
                delai_livraison_jours: parseInt(document.getElementById("delai_livraison_jours").value),
                Order_Month: parseInt(document.getElementById("Order_Month").value),
                Order_Weekday: parseInt(document.getElementById("Order_Weekday").value),
                Order_Quarter: parseInt(document.getElementById("Order_Quarter").value),
                nb_lignes_produits: parseInt(document.getElementById("nb_lignes_produits").value),
                quantite_totale: parseInt(document.getElementById("quantite_totale").value),
                prix_unitaire_moyen: parseFloat(document.getElementById("prix_unitaire_moyen").value),
                nb_produits_uniques: parseInt(document.getElementById("nb_produits_uniques").value),
                prix_total_recalcule: parseFloat(document.getElementById("prix_total_recalcule").value),
                quantite_par_ligne: parseFloat(document.getElementById("quantite_par_ligne").value),
                prix_moyen_par_ligne: parseFloat(document.getElementById("prix_moyen_par_ligne").value)
            };

               const response = await fetch("http://localhost:5001/predict", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });

            if (!response.ok) throw new Error("Échec de la prédiction");

            const result = await response.json();
            console.log("Résultat de la prédiction :", result);

            const prob = parseFloat(result.probability_class_1);
            const isValidProb = !isNaN(prob) && prob >= 0 && prob <= 1;

            const msg = result.prediction === 1
                ? `❌ Résultat : Annulation probable (${isValidProb ? Math.round(prob * 100) : "?"}%)`
                : `✅ Résultat : Validation probable (${isValidProb ? Math.round((1 - prob) * 100) : "?"}%)`;

            document.getElementById("predictionResult").innerText = msg;

            // Mise à jour des prédictions récentes et statistiques
            await fetchRecentPredictions();
            await fetchGlobalStats();

        } catch (error) {
            console.error("Erreur lors de la prédiction :", error);
            document.getElementById("predictionResult").innerText = "Erreur : " + error.message;
        }
    }



    async function init() {
        await fetchClients();
        await fetchGlobalStats();
        await fetchRecentPredictions();
    }

    window.onload = init;
    document.addEventListener("DOMContentLoaded", fetchRecentPredictions);
    document.addEventListener("DOMContentLoaded", fetchClients);

</script>
