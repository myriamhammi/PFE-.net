                        <li><strong>Nombre de jours</strong> pour conclure</li>
                    </ul>

                    <h4>🧠 Modèles disponibles :</h4>
                    <ul>
                        <li>Régression Logistique</li>
                        <li>Random Forest</li>
                        <li>XGBoost</li>
                    </ul>

                    <p>Le modèle retourne un <strong>pourcentage de réussite estimé</strong>. Si ce pourcentage est supérieur à 50%, l’opportunité est considérée comme prometteuse ✅.</p>

                    <p>⏳ La prédiction peut prendre quelques secondes, merci de patienter pendant le chargement !</p>
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <script>
            let clients = [];

            async function loadClients() {
                try {
                    const response = await fetch("http://localhost:5001/get_clients");
                    clients = await response.json();

                    // Remplir la liste des clients dans chaque formulaire existant
                    document.querySelectorAll(".clientSelect").forEach(select => {
                        // D'abord vider les options (sauf les 2 premières)
                        while(select.options.length > 2) {
                            select.remove(2);
                        }
                        clients.forEach(client => {
                            const option = document.createElement("option");
                            option.value = client;
                            option.text = client;
                            select.appendChild(option);
                        });
                    });
                } catch (error) {
                    console.error("Erreur chargement clients:", error);
                }
            }

            function toggleNewClientInput(selectElement) {
                const form = selectElement.closest("form");
                const newClientDiv = form.querySelector(".newClientDiv");
                const newClientInput = form.querySelector(".newClientName");
                if (selectElement.value === "new") {
                    newClientDiv.style.display = "block";
                } else {
                    newClientDiv.style.display = "none";
                    newClientInput.value = "";
                }
            }

            async function predict(form) {
                const selectClient = form.querySelector(".clientSelect").value;
                const newClientName = form.querySelector(".newClientName").value.trim();

                let clientName = "";
                const resultDiv = form.querySelector(".resultatPrediction");
                const progressBar = form.querySelector(".progressBar");

                if (selectClient === "") {
                    resultDiv.innerText = "Veuillez sélectionner un client existant ou choisir Nouveau client.";
                    return;
                }
                if (selectClient === "new") {
                    if (newClientName === "") {
                        resultDiv.innerText = "Veuillez entrer le nom du nouveau client.";
                        return;
                    }
                    clientName = newClientName;
                } else {
                    clientName = selectClient;
                }

                const industry = form.querySelector(".industry").value;
                const lead_source = form.querySelector(".lead_source").value;
                const revenue = parseFloat(form.querySelector(".revenue").value);
                const days = parseInt(form.querySelector(".days").value);
                const model = form.querySelector(".model").value;

                if (isNaN(revenue) || isNaN(days)) {
                    resultDiv.innerText = "Veuillez remplir tous les champs correctement.";
                    return;
                }

                resultDiv.innerText = "";
                progressBar.style.display = "block";
                progressBar.value = 0;

                try {
                    const mappingsResponse = await fetch("http://localhost:5001/get_mappings");
                    const mappings = await mappingsResponse.json();

                    const industryCode = mappings.industry[industry];
                    const leadSourceCode = mappings.lead_source[lead_source];

                    if (industryCode === undefined || leadSourceCode === undefined) {
                        throw new Error("Mapping non trouvé pour industry ou lead source.");
                    }

                    const features = [revenue, days];

                    const response = await fetch("http://localhost:5001/predict", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            model: model,
                            features: features,
                            client_name: clientName,
                            industry: industry,
                            lead_source: lead_source
                        })
                    });

                    if (!response.ok) {
                        throw new Error("Erreur lors de la requête de prédiction.");
                    }

                    const predictionData = await response.json();

                    // Exemple : predictionData = { prediction: 0.78 }

                    progressBar.value = 100;
                    progressBar.style.display = "none";

                    const percent = (predictionData.prediction * 100).toFixed(2);

                    if (predictionData.prediction > 0.5) {
                        resultDiv.innerHTML = `✅ <strong>Probabilité de gain : ${percent}%</strong>`;
                    } else {
                        resultDiv.innerHTML = `❌ <strong>Probabilité de gain : ${percent}%</strong>`;
                    }

                } catch (error) {
                    progressBar.style.display = "none";
                    resultDiv.innerText = `Erreur: ${error.message}`;
                }
            }

            function addForm() {
                const container = document.getElementById("formsContainer");
                const firstForm = container.querySelector("form.prediction-form");
                if (!firstForm) return;

                // Cloner le formulaire
                const newForm = firstForm.cloneNode(true);

                // Nettoyer les champs
                newForm.querySelectorAll("input").forEach(input => input.value = "");
                newForm.querySelectorAll("select").forEach(select => select.selectedIndex = 0);
                newForm.querySelector(".newClientDiv").style.display = "none";
                newForm.querySelector(".resultatPrediction").innerText = "";
                newForm.querySelector(".progressBar").style.display = "none";
                newForm.querySelector(".progressBar").value = 0;

                container.appendChild(newForm);

                // Re-attacher les événements au nouveau formulaire
                const selectClient = newForm.querySelector(".clientSelect");
                selectClient.addEventListener("change", function () {
                    toggleNewClientInput(this);
                });

                const predictBtn = newForm.querySelector(".predictBtn");
                predictBtn.addEventListener("click", function () {
                    predict(newForm);
                });
            }

            window.onload = () => {
                loadClients();

                // Attacher les événements au formulaire initial
                document.querySelectorAll(".clientSelect").forEach(select => {
                    select.addEventListener("change", function () {
                        toggleNewClientInput(this);
                    });
                });

                document.querySelectorAll(".predictBtn").forEach(button => {
                    const form = button.closest("form");
                    button.addEventListener("click", () => predict(form));
                });

                document.getElementById("addFormBtn").addEventListener("click", addForm);
            }
        </script>

        <style>
            progress::-webkit-progress-value {
                transition: width 0.5s ease-in-out;
            }
            label {
                font-weight: 600;
                color: #222;
            }

            input.input-style, select.input-style {
                padding: 8px;
                font-size: 16px;
                border-radius: 8px;
                border: 1px solid #ccc;
                width: 100%;
                box-sizing: border-box;
            }
        </style>
    }
</body>
</html>
