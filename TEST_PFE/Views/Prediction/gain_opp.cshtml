@* 
@{
    ViewData["Title"] = "Prédiction d'opportunité";
    Layout = "~/Pages/Shared/_KPIsLayout.cshtml";
}
<html>
<body>
    <section style="background: #f4f4f8; min-height: 100vh; font-family: 'Segoe UI', sans-serif; padding: 40px;">
    <div style="max-width: 1200px; margin: 0 auto; background: #ffffff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1); padding: 40px; margin-top: 40px">

        <h2 style="text-align: center; color: #333; margin-bottom: 40px;">
            🔍 Prédire le gain d'une opportunité commerciale
        </h2>

        <div style="display: flex; flex-direction: row; gap: 40px; flex-wrap: wrap;">
            
            <!-- Formulaire -->
            <div style="flex: 1; min-width: 300px;">
                <form id="prediction-form" style="display: flex; flex-direction: column; gap: 20px;">

                    <!-- Client -->
                    <div>
                        <label for="clientSelect">Nom du client :</label>
                        <select id="clientSelect" class="input-style" onchange="toggleNewClientInput()">
                            <option value="">-- Sélectionner un client existant --</option>
                            <option value="new">➕ Nouveau client</option>
                        </select>
                    </div>

                    <div id="newClientDiv" style="display:none;">
                        <label for="newClientName">Nom du nouveau client :</label>
                        <input type="text" id="newClientName" class="input-style" placeholder="Entrez le nom du client" />
                    </div>

                    <!-- Industrie -->
                    <div>
                        <label for="industry">Secteur d'activité :</label>
                        <select id="industry" class="input-style">
                            <option value="Education">Éducation</option>
                            <option value="Finance">Finance</option>
                            <option value="Healthcare">Santé</option>
                            <option value="Manufacturing">Industrie</option>
                            <option value="Real Estate">Immobilier</option>
                            <option value="Retail">Commerce</option>
                            <option value="Technology">Technologie</option>
                        </select>
                    </div>

                    <!-- Lead Source -->
                    <div>
                        <label for="lead_source">Source du lead :</label>
                        <select id="lead_source" class="input-style">
                            <option value="Event">Événement</option>
                            <option value="Referral">Parrainage</option>
                            <option value="Email Campaign">Campagne Email</option>
                            <option value="Cold Call">Appel à froid</option>
                            <option value="Advertisement">Publicité</option>
                            <option value="Social Media">Réseaux sociaux</option>
                            <option value="Website">Site web</option>
                        </select>
                    </div>

                    <!-- Revenu -->
                    <div>
                        <label for="revenue">Potentiel de revenu (TND) :</label>
                        <input type="number" id="revenue" class="input-style" step="0.01" />
                    </div>

                    <!-- Jours -->
                    <div>
                        <label for="days">Jours pour conclure :</label>
                        <input type="number" id="days" class="input-style" />
                    </div>

                    <!-- Modèle -->
                    <div>
                        <label for="model">Modèle :</label>
                        <select id="model" class="input-style">
                            <option value="logreg">Régression Logistique</option>
                            <option value="rf">Random Forest</option>
                            <option value="xgb">XGBoost</option>
                        </select>
                    </div>

                    <!-- Bouton -->
                    <button type="button" onclick="predict()" style="background-color: #ffe600; color: black; font-weight: bold; border: none; padding: 12px; border-radius: 10px; cursor: pointer;">
                        🚀 Prédire
                    </button>

                    <progress id="progressBar" value="0" max="100" style="width: 100%; height: 20px; display: none;"></progress>

                    <div id="resultatPrediction" style="margin-top: 20px; font-weight: bold;"></div>
                </form>
            </div>

            <!-- À propos -->
            <div style="flex: 1; min-width: 300px; background: #f9f9f9; border-left: 5px solid #ffe600; padding: 20px; border-radius: 10px;">
                <h3 style="color: #333;">📘 À propos de cette prédiction</h3>
                <p>Cette application permet de prédire la probabilité de <strong>gagner une opportunité commerciale</strong>.</p>

                <h4>🔢 Données utilisées :</h4>
                <ul>
                    <li><strong>Secteur d'activité</strong></li>
                    <li><strong>Source du lead</strong></li>
                    <li><strong>Potentiel de revenu</strong> (en dinars)</li>
                    <li><strong>Nombre de jours</strong> pour conclure</li>
                </ul>

                <h4>🧠 Modèles disponibles :</h4>
                <ul>
                    <li>Régression Logistique</li>
                    <li>Random Forest</li>
                    <li>XGBoost</li>
                </ul>

                <p>Le modèle retourne un <strong>pourcentage de réussite estimé</strong>. Si ce pourcentage est supérieur à 50%, l’opportunité est considérée comme prometteuse ✅.</p>

                <p>⏳ La prédiction peut prendre quelques secondes, merci de patienter pendant le chargement !</p>
            </div>
        </div>
    </div>
</section>

    @section Scripts {
        <script>
            let clients = [];

            // Récupère la liste des clients existants au chargement
            async function loadClients() {
                try {
                    const response = await fetch("http://localhost:5001/get_clients");
                    clients = await response.json();

                    const select = document.getElementById("clientSelect");
                    clients.forEach(client => {
                        const option = document.createElement("option");
                        option.value = client;
                        option.text = client;
                        select.appendChild(option);
                    });
                } catch (error) {
                    console.error("Erreur chargement clients:", error);
                }
            }

            // Montre ou cache l'input nouveau client selon le choix
            function toggleNewClientInput() {
                const select = document.getElementById("clientSelect");
                const newClientDiv = document.getElementById("newClientDiv");
                if (select.value === "new") {
                    newClientDiv.style.display = "block";
                } else {
                    newClientDiv.style.display = "none";
                    document.getElementById("newClientName").value = "";
                }
            }

            async function predict() {
                const selectClient = document.getElementById("clientSelect").value;
                const newClientName = document.getElementById("newClientName").value.trim();

                let clientName = "";
                if (selectClient === "") {
                    document.getElementById("resultatPrediction").innerText = "Veuillez sélectionner un client existant ou choisir Nouveau client.";
                    return;
                }
                if (selectClient === "new") {
                    if (newClientName === "") {
                        document.getElementById("resultatPrediction").innerText = "Veuillez entrer le nom du nouveau client.";
                        return;
                    }
                    clientName = newClientName;
                } else {
                    clientName = selectClient;
                }

                const industry = document.getElementById("industry").value;
                const lead_source = document.getElementById("lead_source").value;
                const revenue = parseFloat(document.getElementById("revenue").value);
                const days = parseInt(document.getElementById("days").value);
                const model = document.getElementById("model").value;

                if (isNaN(revenue) || isNaN(days)) {
                    document.getElementById("resultatPrediction").innerText = "Veuillez remplir tous les champs correctement.";
                    return;
                }

                try {
                    const mappingsResponse = await fetch("http://localhost:5001/get_mappings");
                    const mappings = await mappingsResponse.json();

                    const industryCode = mappings.industry[industry];
                    const leadSourceCode = mappings.lead_source[lead_source];

                    if (industryCode === undefined || leadSourceCode === undefined) {
                        throw new Error("Mapping non trouvé pour industry ou lead source.");
                    }

                    const features = [revenue, days];

                    const response = await fetch("http://localhost:5001/predict", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            model: model,
                            features: features,
                            client_name: clientName,
                            industry: industry,
                            lead_source: lead_source
                        })
                    });

                    if (!response.ok) {
                        throw new Error("La requête a échoué avec le statut " + response.status);
                    }

                    const result = await response.json();
                    // document.getElementById("resultatPrediction").innerText =
                    //     `Résultat : ${Math.round(result.prediction * 100)}% de chance de succès avec le modèle ${result.model}`;
                                const predictionPourcentage = Math.round(result.prediction * 100);
                    const message = predictionPourcentage >= 50
                         ? `✅ L'opportunité a ${predictionPourcentage}% de chance d'être gagnée (modèle : ${result.model})`
                         : `⚠️ L'opportunité a seulement ${predictionPourcentage}% de chance d'être gagnée (modèle : ${result.model})`;

                    const predictionDiv = document.getElementById("resultatPrediction");
                         predictionDiv.innerText = message;
                         predictionDiv.style.color = predictionPourcentage >= 50 ? "#28a745" : "#dc3545";
                         predictionDiv.style.background = "#f8f9fa";
                         predictionDiv.style.padding = "10px";
                         predictionDiv.style.borderRadius = "10px";
                         predictionDiv.style.border = "1px solid #ccc";

                     const progressBar = document.getElementById("progressBar");
                                progressBar.style.display = "block";
                                progressBar.value = predictionPourcentage;
                                progressBar.style.backgroundColor = predictionPourcentage >= 50 ? "#28a745" : "#dc3545";

                     predictionDiv.innerHTML = `
                    <div>
                        ${message}
                        <br />
                        🔁 Modèle utilisé : <strong>${result.model}</strong>
                    </div>
                `;
                            predictionDiv.innerHTML = `
                                <div>
                                    ${message}
                                    <br />
                                    🔁 Modèle utilisé : <strong>${result.model}</strong>
                                </div>
                            `;


                     } catch (error) {
                         console.error("Erreur lors de la prédiction :", error);
                         document.getElementById("resultatPrediction").innerText =
                        "Erreur lors de la prédiction. Vérifiez que l'API Flask fonctionne et que les données sont valides.";
                       }
                                  

            }

            // Charger les clients au chargement de la page
            window.onload = () => {
                loadClients();
            };
        </script>
    }


    <style>

        progress::-webkit-progress-value {
            transition: width 0.5s ease-in-out;
        }

        #resultatPrediction {
            transition: all 0.5s ease-in-out;
        }

        .input-style {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
            background: #fff;
            color: #333;
            font-size: 1rem;
        }

            .input-style:focus {
                outline: none;
                border-color: #ffe600;
                box-shadow: 0 0 3px rgba(0, 123, 255, 0.5);
            }

        button:hover {
            background-color: #ffe600;
        }

        label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
            color: #333;
        }
    </style>
</body>
</html>


