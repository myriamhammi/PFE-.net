        <div style="max-width: 1200px; margin: 0 auto; background: #ffffff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1); padding: 40px; margin-top: 40px">

            <h2 style="text-align: center; color: #333; margin-bottom: 40px;">
