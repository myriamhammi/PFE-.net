                                    <option value="Retail">Commerce</option>
                                    <option value="Technology">Technologie</option>
                                </select>
                            </div>

                            <!-- Lead Source -->
                            <div>
                                <label>Source du lead :</label>
                                <select class="lead_source input-style">
                                    <option value="Event">Événement</option>
                                    <option value="Referral">Parrainage</option>
                                    <option value="Email Campaign">Campagne Email</option>
                                    <option value="Cold Call">Appel à froid</option>
                                    <option value="Advertisement">Publicité</option>
                                    <option value="Social Media">Réseaux sociaux</option>
                                    <option value="Website">Site web</option>
                                </select>
                            </div>

                            <!-- Revenu -->
                            <div>
                                <label>Potentiel de revenu (TND) :</label>
                                <input type="number" class="revenue input-style" step="0.01" />
                            </div>

                            <!-- Jours -->
                            <div>
                                <label>Jours pour conclure :</label>
                                <input type="number" class="days input-style" />
                            </div>

                            <!-- Modèle -->
                            <div>
                                <label>Modèle :</label>
                                <select class="model input-style">
                                    <option value="logreg">Régression Logistique</option>
                                    <option value="rf">Random Forest</option>
                                    <option value="xgb">XGBoost</option>
                                </select>
                            </div>

                            <!-- Bouton prédire -->
                            <button type="button" class="predictBtn" style="background-color: #ffe600; color: black; font-weight: bold; border: none; padding: 12px; border-radius: 10px; cursor: pointer;">
                                🚀 Prédire
                            </button>

                            <progress class="progressBar" value="0" max="100" style="width: 100%; height: 20px; display: none;"></progress>

                            <div class="resultatPrediction" style="margin-top: 20px; font-weight: bold;"></div>
                        </form>
                    </div>

                    <!-- Bouton pour ajouter un formulaire -->
                    <button id="addFormBtn" type="button" style="margin-top: 20px; background-color: #ffe600; color: white;  font-weight: bold; padding: 10px 15px; border: none; border-radius: 10px; cursor: pointer;">
                        ➕ Ajouter un formulaire de prédiction
                    </button>
                </div>

                <!-- À propos -->
                <div style="flex: 1; min-width: 300px; background: #f9f9f9; border-left: 5px solid #ffe600; padding: 20px; border-radius: 10px;">
