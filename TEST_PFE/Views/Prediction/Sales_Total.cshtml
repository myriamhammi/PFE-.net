@{
    ViewData["Title"] = "Prédiction Montant total de la commande";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">Estimation du montant total de la commande</h2>

    <div id="formsContainer">
        <!-- Premier formulaire (prototype à dupliquer) -->
        <div class="prediction-form card shadow-lg p-4 mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nom du client</label>
                    <select class="form-select client_name" onchange="toggleCustomClient(this)">
                        <option disabled selected>Choisissez un client</option>
                        <option value="__custom__">➕ Nouveau client</option>
                    </select>
                    <input type="text" class="form-control custom_client_name d-none" placeholder="Entrez le nom complet du client" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Secteur d’activité</label>
                    <select class="form-select industry">
                        <option>Technology</option>
                        <option>Finance</option>
                        <option>Healthcare</option>
                        <option>Retail</option>
                        <option>Education</option>
                        <option>Manufacturing</option>
                        <option>Real Estate</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Revenu potentiel (TND)</label>
                    <input type="range" class="form-range revenue" min="1000" max="200000" step="1000" oninput="this.nextElementSibling.value = this.value" />
                    <output class="revenueOutput">1000</output>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Montant du devis (TND)</label>
                    <input type="number" class="form-control quote_total" placeholder="75000" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Étape de l'opportunité</label>
                    <select class="form-select stage">
                        <option>Negotiation</option>
                        <option>Closed Won</option>
                        <option>Closed Lost</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Produit concerné</label>
                    <select class="form-select product">
                        <option>ERP System</option>
                        <option>Business Analytics</option>
                        <option>Custom Development</option>
                        <option>Cybersecurity Suite</option>
                        <option>IT Support</option>
                        <option>Cloud Hosting</option>
                        <option>CRM Software</option>
                    </select>
                </div>

                <div class="col-12 d-flex justify-content-between mt-3">
                    <button class="btn btn-danger d-none remove-btn" onclick="removeForm(this)">🗑️ Supprimer ce formulaire</button>
                    <button class="btn btn-primary" onclick="makePrediction(this)">Lancer la prédiction</button>
                </div>

            </div>
        </div>
    </div>

    <button id="addFormBtn" type="button" class="btn btn-warning mt-3 fw-bold" onclick="addForm()">
        ➕ Ajouter un formulaire de prédiction
    </button>

    <div id="resultsContainer" class="mt-4"></div>

    <!-- Bouton global pour lancer toutes les prédictions si nécessaire -->
    <!-- <button id="predictBtn" class="btn btn-success mt-4" onclick="makeAllPredictions()">Lancer toutes les prédictions</button> -->
</div>

<script>
    async function loadClients(selectElement) {
        try {
            const response = await fetch("http://127.0.0.1:5001/get_clients");
            const clients = await response.json();

            selectElement.innerHTML = `
                <option disabled selected>Choisissez un client</option>
                <option value="__custom__">➕ Nouveau client</option>
            `;
            clients.forEach(client => {
                const option = document.createElement("option");
                option.value = client;
                option.text = client;
                selectElement.appendChild(option);
            });
        } catch (error) {
            console.error("Erreur lors du chargement des clients:", error);
        }
    }

    function toggleCustomClient(select) {
        const container = select.closest(".prediction-form");
        const customInput = container.querySelector(".custom_client_name");
        customInput.classList.toggle("d-none", select.value !== "__custom__");
        if (select.value === "__custom__") customInput.focus();
    }

    function addForm() {
        const container = document.getElementById("formsContainer");
        const template = container.querySelector(".prediction-form");
        const clone = template.cloneNode(true);

        // Reset inputs
        clone.querySelectorAll("input, select, output").forEach(el => {
            if (el.tagName === "SELECT") {
                if (el.classList.contains("client_name")) {
                    loadClients(el);
                } else {
                    el.selectedIndex = 0;
                }
            } else if (el.type === "range") {
                el.value = 1000;
                el.nextElementSibling.value = 1000;
            } else {
                el.value = "";
            }
        });

        // Afficher bouton de suppression
        const removeBtn = clone.querySelector(".remove-btn");
        removeBtn.classList.remove("d-none");


        container.appendChild(clone);
    }

    function removeForm(button) {
        const form = button.closest(".prediction-form");
        form.remove();
    }

    async function makePrediction(button) {
        const form = button.closest(".prediction-form");
        const clientSelect = form.querySelector(".client_name");
        const customClientInput = form.querySelector(".custom_client_name");
        const clientName = clientSelect.value === "__custom__" ? customClientInput.value : clientSelect.value;
        const industry = form.querySelector(".industry").value;
        const stage = form.querySelector(".stage").value;
        const product = form.querySelector(".product").value;
        const revenue = parseFloat(form.querySelector(".revenue").value);
        const quote = parseFloat(form.querySelector(".quote_total").value);

        if (!clientName || isNaN(revenue) || isNaN(quote)) {
            alert("Veuillez remplir tous les champs correctement.");
            return;
        }

        const payload = {
            Full_Name: clientName,
            client_name: clientName,
            customer_industry: industry,
            opportunity_stage: stage,
            product_name: product,
            Revenue_Potential: revenue,
            Quote_Total: quote
        };

        try {
            const response = await fetch("http://127.0.0.1:5001/predict", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            const result = await response.json();
            const resultsContainer = document.getElementById("resultsContainer");

            if (response.ok) {
                resultsContainer.innerHTML += `
                    <div class="alert alert-info mt-3">
                        <h5>Résultat pour ${clientName}</h5>
                        <strong>Modèle utilisé :</strong> ${result.model}<br/>
                        <strong>Statut client :</strong> ${result.client_status}<br/>
                        <strong>Montant estimé :</strong> ${result.prediction.toLocaleString()} TND
                    </div>
                `;
            } else {
                resultsContainer.innerHTML += `<div class="alert alert-danger mt-3">Erreur pour ${clientName} : ${result.error || result.message}</div>`;
            }
        } catch (error) {
            document.getElementById("resultsContainer").innerHTML += `<div class="alert alert-danger mt-3">Erreur réseau pour ${clientName} : ${error.message}</div>`;
        }
    }

    // Initialisation au chargement de la page
    window.onload = () => {
        const firstSelect = document.querySelector(".client_name");
        loadClients(firstSelect);
    };
</script>
