               let selectedSchema = "";
        let selectedTable = "";

        async function loadTables() {
            const tableList = document.getElementById('tableList');
            tableList.innerHTML = '<li>Chargement...</li>';

            try {
                const response = await fetch(`/tables`);
                if (!response.ok) throw new Error(`Erreur HTTP ${response.status}`);

                const tables = await response.json();

                tableList.innerHTML = "";
                tables.forEach(fullName => {
                    const li = document.createElement('li');
                    li.textContent = fullName;
                    li.style.cursor = 'pointer';
                    li.onclick = () => {
                        const [schema, table] = fullName.split('.');
                        selectedSchema = schema;
                        selectedTable = table;

                        document.getElementById('selectedTableSection').style.display = 'block';
                        document.getElementById('selectedTableTitle').textContent = fullName;

                        loadColumns(schema, table);
                        loadRecords(schema, table);
                    };
                    tableList.appendChild(li);
                });

                if(tables.length === 0) {
                    tableList.innerHTML = '<li>Aucune table trouvée</li>';
                }
            } catch (error) {
                console.error('Erreur chargement des tables:', error);
                tableList.innerHTML = '<li>Erreur lors du chargement des tables.</li>';
            }
        }

        async function loadColumns(schema, table) {
            const columnSelect = document.getElementById('columnSelect');
            columnSelect.innerHTML = '<option value="">-- Chargement... --</option>';

            try {
                const response = await fetch(`/columns/${schema}/${table}`);
                if (!response.ok) throw new Error(`Erreur HTTP ${response.status}`);

                const columns = await response.json();

                columnSelect.innerHTML = '<option value="">-- Sélectionnez une colonne --</option>';
                columns.forEach(col => {
                    const option = document.createElement('option');
                    option.value = col;
                    option.textContent = col;
                    columnSelect.appendChild(option);
                });
            } catch (error) {
                console.error("Erreur chargement colonnes:", error);
                columnSelect.innerHTML = '<option value="">Erreur lors du chargement</option>';
            }
        }

        async function loadRecords(schema, table) {
            const recordsTable = document.getElementById('recordsTable');
            recordsTable.innerHTML = '<p>Chargement des enregistrements...</p>';

            try {
                const response = await fetch(`/records/${schema}/${table}`);
                if (!response.ok) throw new Error(`Erreur HTTP ${response.status}`);

                const data = await response.json();

                if (!data.length) {
                    recordsTable.innerHTML = '<p>Aucun enregistrement trouvé.</p>';
                    return;
                }

                renderRecordsTable(data);
            } catch (error) {
                console.error('Erreur chargement des enregistrements:', error);
                recordsTable.innerHTML = '<p>Erreur lors du chargement des données.</p>';
            }
        }

        async function filterRecords() {
            const column = document.getElementById('columnSelect').value;
            const value = document.getElementById('filterValue').value.trim();

            if (!column || !value) {
                alert("Veuillez sélectionner une colonne et saisir une valeur !");
                return;
            }

            const recordsTable = document.getElementById('recordsTable');
            recordsTable.innerHTML = '<p>Filtrage en cours...</p>';

            try {
                const url = `/records/${selectedSchema}/${selectedTable}/filter?column=${encodeURIComponent(column)}&value=${encodeURIComponent(value)}`;
                const response = await fetch(url);

                if (!response.ok) {
                    const errorText = await response.text();
                    recordsTable.innerHTML = `<p style="color:red;">Erreur : ${errorText}</p>`;
                    return;
                }

                const data = await response.json();

                if (!data.length) {
                    recordsTable.innerHTML = '<p>Aucun résultat trouvé pour ce filtre.</p>';
                    return;
                }

                renderRecordsTable(data);
            } catch (error) {
                console.error('Erreur filtrage:', error);
                recordsTable.innerHTML = '<p>Erreur lors du filtrage des données.</p>';
            }
        }

        function renderRecordsTable(data) {
            const recordsTable = document.getElementById('recordsTable');
            const table = document.createElement('table');
            table.border = '1';
            table.classList.add('data-table');

            // Header
            const headerRow = document.createElement('tr');
            Object.keys(data[0]).forEach(key => {
                const th = document.createElement('th');
                th.textContent = key;
                headerRow.appendChild(th);
            });
            table.appendChild(headerRow);

            // Data
            data.forEach(row => {
                const tr = document.createElement('tr');
                Object.values(row).forEach(value => {
                    const td = document.createElement('td');
                    td.textContent = value ?? '';  // gérer les null
                    tr.appendChild(td);
                });
                table.appendChild(tr);
            });

            recordsTable.innerHTML = '';
            recordsTable.appendChild(table);
        }

        // Charger les tables au chargement de la page
        window.onload = () => {
            loadTables();
        };


