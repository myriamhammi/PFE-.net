<div class="container py-5">
    <h2 class="text-center mb-5">Lancer un processus ETL</h2>

    <div class="row g-3 mb-4">
        @{
            var tables = new[] {
        ("Toutes", "fas fa-layer-group"),
        ("Prospect", "fas fa-user-plus"),
        ("Compte", "fas fa-building"),
        ("Contact", "fas fa-address-book"),
        ("Opportunity", "fas fa-bullseye"),
        ("Quote", "fas fa-file-invoice"),
        ("Sales", "fas fa-shopping-cart"),
        ("QuoteProduct", "fas fa-box-open"),
        ("OpportunityProduct", "fas fa-boxes"),
        ("SalesProduct", "fas fa-box")
        };

            foreach (var table in tables)
            {
                <div class="col-md-4">
                    <div class="card table-card p-3" onclick="selectTable('@table.Item1')">
                        <div class="card-body d-flex align-items-center">
                            <i class="@table.Item2 card-icon me-3"></i>
                            <h5 class="mb-0">@table.Item1</h5>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Étapes du processus ETL -->
    <div class="progress-steps mb-4">
        <span id="step-upload" class="progress-step">Upload</span>
        <span id="step-transform" class="progress-step">Transformation</span>
        <span id="step-load" class="progress-step">Chargement</span>
    </div>

    <form id="etlForm" asp-action="UploadFile" method="post" enctype="multipart/form-data">
        <input type="hidden" name="selectedTable" id="selectedTable" value="" />

        <div class="mb-3">
            <label for="uploadedFile" class="form-label">Choisir un fichier</label>
            <input type="file" class="form-control" name="uploadedFile" id="uploadedFile" required disabled />
        </div>

        <button type="submit" class="btn btn-primary" id="startETLButton" disabled>
            <i class="fas fa-play"></i> Lancer ETL
        </button>
    </form>

    <!-- Fichiers récents -->
    @{
        var recentFiles = TempData["RecentFiles"] as List<string>;
    }

    <div class="recent-files mt-5">
        <h5 class="section-title">Fichiers récents</h5>
        <ul id="recentFilesList">
            @if (recentFiles != null && recentFiles.Any())
            {
                foreach (var file in recentFiles)
                {
                    <li>
                        <i class="fas fa-file-csv me-2 text-secondary"></i> @file
                    </li>
                }
            }
            else
            {
                <li>Aucun fichier récent disponible.</li>
            }
        </ul>
    </div>


    <!-- Message -->
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Message
        </div>
    }

    @if (ViewBag.PackageOutput != null)
    {
        <div class="alert alert-info">
            <strong>Sortie du package :</strong> @ViewBag.PackageOutput
        </div>
    }

    @if (ViewBag.PackageError != null)
    {
        <div class="alert alert-warning">
            <strong>Erreur du package :</strong> @ViewBag.PackageError
        </div>
    }

</div>

@section Scripts {
    <script>
        function selectTable(tableName) {
            document.getElementById("selectedTable").value = tableName;

            // Désactiver ou activer le fichier et le bouton en fonction de la sélection
            if (tableName === "Toutes") {
                document.getElementById("uploadedFile").disabled = true;
                document.getElementById("startETLButton").disabled = false;
                document.getElementById("startETLButton").innerHTML = `<i class="fas fa-play"></i> Lancer ETL`;
            } else {
                document.getElementById("uploadedFile").disabled = false;
                document.getElementById("startETLButton").disabled = false;
                document.getElementById("startETLButton").innerHTML = `<i class="fas fa-play"></i> Lancer ${tableName} ETL`;
            }

            // Reset progression
            document.querySelectorAll('.progress-step').forEach(e => e.classList.remove('active'));
            document.getElementById('step-upload').classList.add('active');
        }

        document.getElementById("etlForm").addEventListener("submit", function (event) {
            event.preventDefault(); // Prevent the form from submitting the traditional way

            // Désactiver le bouton et afficher le spinner
            document.getElementById("startETLButton").disabled = true;
            document.getElementById("loadingSpinner").style.display = "block";

            // Lancer les étapes du processus ETL
            document.getElementById("step-upload").classList.remove("active");
            document.getElementById("step-transform").classList.add("active");

            setTimeout(() => {
                document.getElementById("step-transform").classList.remove("active");
                document.getElementById("step-load").classList.add("active");
            }, 2000);

            // Soumettre le formulaire via AJAX
            var formData = new FormData(document.getElementById("etlForm"));
            $.ajax({
                url: '@Url.Action("UploadFile", "ETL")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    document.getElementById("loadingSpinner").style.display = "none";
                    if (response.success) {
                        document.getElementById("step-load").classList.remove("active");
                        alert("ETL terminé avec succès !");
                    } else {
                        alert("Erreur : " + response.message);
                    }
                },
                error: function () {
                    alert("Erreur lors de l'exécution de l'ETL.");
                    document.getElementById("loadingSpinner").style.display = "none";
                }
            });
        });
    </script>
}

 *@


