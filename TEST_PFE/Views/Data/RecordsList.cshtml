@model IEnumerable<Microsoft.Xrm.Sdk.Entity>

@{
    ViewData["Title"] = "Liste des Enregistrements";
    var entityName = ViewData["EntityName"] as string;
}

<div class="container-fluid mt-5">
    <!-- Titre principal sans fond bleu -->
    <h2 class="text-center microsoft-blue font-weight-bold mb-4" style="font-family: 'Segoe UI', sans-serif; font-size: 30px; text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);">
        Liste des Enregistrements pour l'entité : @entityName
    </h2>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb p-3 rounded" style="background-color: #F4F4F4;">
            <li class="breadcrumb-item">
                <a href="@Url.Action("GetEntities", "Crm")" class="text-primary">Entités</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@entityName</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow-lg mb-5 rounded">
        <!-- Titre secondaire sans bord bleu, mais avec ombre légère pour un effet plus subtil -->
        <div class="card-header bg-transparent text-dark d-flex justify-content-between align-items-center">
            <h4 class="m-0" style="font-family: 'Segoe UI', sans-serif; font-size: 24px; font-weight: 600; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.05);">
                Détails des Enregistrements
            </h4>
            
        </div>
        <div class="card-body collapse show" id="tableSection">
            <div class="table-responsive">
                <table class="table table-striped table-bordered w-100 table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Créé le</th>
                            <th>Modifié le</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td>@record.Id</td>
                                <td>@(record.Attributes.TryGetValue("name", out var nameValue) ? nameValue?.ToString() : "N/A")</td>
                                <td>
                                    @if (record.Attributes.TryGetValue("createdon", out var createdOnValue) && createdOnValue is DateTime createdOn)
                                    {
                                        @createdOn.ToString("yyyy-MM-dd HH:mm")
                                    }
                                    else
                                    {
                                        @("N/A")
                                    }
                                </td>
                                <td>
                                    @if (record.Attributes.TryGetValue("modifiedon", out var modifiedOnValue) && modifiedOnValue is DateTime modifiedOn)
                                    {
                                        @modifiedOn.ToString("yyyy-MM-dd HH:mm")
                                    }
                                    else
                                    {
                                        @("N/A")
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("GetRecordForUpdate", "Crm", new { entityName = entityName, id = record.Id })"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <form asp-action="DeleteRecord" method="post" style="display:inline;"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet enregistrement ?');">
                                        <input type="hidden" name="entityName" value="@entityName" />
                                        <input type="hidden" name="id" value="@record.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <a href="@Url.Action("GetEntities", "Crm")" class="btn btn-outline-secondary microsoft-yellow btn-lg">
            <i class="fas fa-arrow-left"></i> Retour aux entités
        </a>
    </div>
</div>

<style>
    /* Personnalisation des couleurs Microsoft */
    .microsoft-blue {
        color: #0078D4 !important;
    }

    .microsoft-green {
        background-color: #107C10 !important;
        color: white !important;
    }

    .microsoft-yellow {
        background-color: #FFB900 !important;
        color: black !important;
    }

    .microsoft-red {
        background-color: #D83B01 !important;
        color: white !important;
    }

    /* Style général du tableau */
    .table {
        border-radius: 10px;
        border-collapse: separate;
        border-spacing: 0;
        background-color: #ffffff;
    }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
            padding: 15px;
            font-size: 14px;
        }

        .table thead {
            background-color: #0078D4;
            color: white;
        }

    .table-hover tbody tr:hover {
        background-color: #f4f4f4;
    }

    /* Espacement et éléments de la page */
    .container-fluid {
        padding: 20px;
    }

    /* Effets des boutons */
    .btn {
        transition: all 0.3s ease-in-out;
        border-radius: 4px;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

    /* Design du breadcrumb */
    .breadcrumb {
        background-color: #F4F4F4;
        border-radius: 8px;
    }

    .breadcrumb-item a {
        color: #0078D4;
        font-weight: bold;
    }

        .breadcrumb-item a:hover {
            text-decoration: underline;
        }

    /* Boutons action de table */
    .btn-outline-primary, .btn-outline-danger {
        transition: all 0.2s ease-in-out;
    }

        .btn-outline-primary:hover, .btn-outline-danger:hover {
            background-color: #0078D4;
            color: white;
        }

    /* Effet d'ombre sur les titres */
    h2, h4 {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 600;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
    }
</style>
