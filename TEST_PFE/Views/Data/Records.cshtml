

 
 @model List<Dictionary<string, object>>
@{
    Layout = "~/Pages/Shared/_CRMLayout.cshtml";
    ViewData["Title"] = "Liste des Enregistrements";
    var entityName = ViewData["EntityName"] as string;
    var totalRecords = Model?.Count ?? 0;
    var totalColumns = Model?.FirstOrDefault()?.Count ?? 0;
    var nullCount = Model?.SelectMany(d => d.Values).Count(v => v == null) ?? 0;
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 text-gray-800">
            <i class="fas fa-database me-2 text-primary"></i>Enregistrements - @entityName
        </h1>
    </div>

    <!-- Statistiques Résumées -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-left-primary h-100 py-2 rounded">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total des Enregistrements</div>
                    <div class="h5 mb-0 font-weight-bold text-dark">@totalRecords</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-left-info h-100 py-2 rounded">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Nombre de Colonnes</div>
                    <div class="h5 mb-0 font-weight-bold text-dark">@totalColumns</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-left-danger h-100 py-2 rounded">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Valeurs Nulles Détectées</div>
                    <div class="h5 mb-0 font-weight-bold text-dark">@nullCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions principales -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="@Url.Action("GetEntities", "Crm")" class="btn btn-outline-secondary shadow-sm me-2 rounded">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <button class="btn btn-outline-primary shadow-sm me-2 rounded" id="exportCSV">
                <i class="fas fa-file-csv"></i> Export CSV
            </button>
            <button class="btn btn-outline-success shadow-sm rounded" id="exportExcel">
                <i class="fas fa-file-excel"></i> Export Excel
            </button>
        </div>
        <button class="btn btn-primary shadow-sm rounded" data-bs-toggle="modal" data-bs-target="#addRecordModal">
            <i class="fas fa-plus me-1"></i> Ajouter un Enregistrement
        </button>
    </div>

    <!-- Sélecteur de colonnes -->
    <div class="mb-4">
        <label class="fw-bold mb-2" for="columnSelector">
            <i class="fas fa-columns me-1 text-secondary"></i> Colonnes à afficher :
        </label>
        <select id="columnSelector" multiple class="form-select border rounded shadow-sm" style="height: 200px; overflow-y: auto;">
            @if (Model.Any())
            {
                var index = 0;
                foreach (var key in Model.First().Keys)
                {
                    <option value="@index" selected>@key</option>
                    index++;
                }
            }
        </select>
    </div>

    <!-- Table des enregistrements -->
    <div class="card shadow mb-5 rounded">
        <div class="card-body">
            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover table-bordered table-striped align-middle text-center sticky-header" id="recordsTable">

                    <thead class="table-light text-primary">
                        <tr>
                            @if (Model.Any())
                            {
                                foreach (var key in Model.First().Keys)
                                {
                                    <th>@key</th>
                                }
                            }
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr id="row-@row.Keys.First()">
                                @foreach (var value in row.Values)
                                {
                                    <td>
                                        @{
                                            string displayValue = value switch
                                            {
                                                Microsoft.Xrm.Sdk.Money money => money.Value.ToString("N2"),
                                                Microsoft.Xrm.Sdk.OptionSetValue option => option.Value.ToString(),
                                                Microsoft.Xrm.Sdk.EntityReference er => er.Name ?? er.Id.ToString(),
                                                DateTime date => date.ToString("yyyy-MM-dd HH:mm"),
                                                _ => value?.ToString() ?? ""
                                            };
                                        }
                                        @displayValue
                                    </td>
                                }
                                <td>
                                    <button class="btn btn-warning btn-sm rounded me-1" data-bs-toggle="modal" data-bs-target="#updateRecordModal"
                                            onclick="openEditModal('@row.Keys.First()')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm rounded" data-bs-toggle="modal" data-bs-target="#deleteRecordModal"
                                            onclick="openDeleteModal('@row.Keys.First()')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Ajout -->
    <div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajouter un Enregistrement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <form id="addRecordForm">
                        @foreach (var key in Model.First().Keys)
                        {
                            <div class="mb-3">
                                <label for="add_@key" class="form-label">@key</label>
                                <input type="text" class="form-control" id="add_@key" name="add_@key" required />
                            </div>
                        }
                        <button type="submit" class="btn btn-primary">Ajouter</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Édition -->
    <div class="modal fade" id="updateRecordModal" tabindex="-1" aria-labelledby="updateRecordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modifier l'Enregistrement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <form id="updateRecordForm">
                        <div id="modalFields"></div>
                        <button type="submit" class="btn btn-primary">Mettre à jour</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Suppression -->
    <div class="modal fade" id="deleteRecordModal" tabindex="-1" aria-labelledby="deleteRecordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la Suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body" id="deleteRecordMessage">
                    <!-- Message de confirmation ici -->
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" id="confirmDeleteButton">Supprimer</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .sticky-header thead th {
        position: sticky;
        top: 0;
        background-color: #cccccc;
        z-index: 1;
    }
</style>

@section Scripts {
    <script>
        const entityName = '@ViewData["EntityName"]';

        document.getElementById("exportExcel").addEventListener("click", () => {
            const table = document.getElementById("recordsTable");
            const wb = XLSX.utils.table_to_book(table, { sheet: "Enregistrements" });
            XLSX.writeFile(wb, `${entityName}.xlsx`);
        });

        document.getElementById("exportCSV").addEventListener("click", () => {
            const table = document.getElementById("recordsTable");
            const wb = XLSX.utils.table_to_book(table, { sheet: "Enregistrements" });
            XLSX.writeFile(wb, `${entityName}.csv`);
        });

        document.getElementById("columnSelector").addEventListener("change", function () {
            const selectedIndexes = Array.from(this.selectedOptions).map(option => parseInt(option.value));
            const table = document.getElementById("recordsTable");

            for (let row of table.rows) {
                for (let i = 0; i < row.cells.length - 1; i++) {
                    row.cells[i].style.display = selectedIndexes.includes(i) ? '' : 'none';
                }
            }
        });

        function openEditModal(recordId) {
            const row = document.getElementById('row-' + recordId);
            const modalFields = document.getElementById('modalFields');
            modalFields.innerHTML = '';

            const cells = row.getElementsByTagName('td');
            let index = 0;

            for (const cell of cells) {
                if (index < cells.length - 1) {
                    const fieldName = `field_${index}`;
                    const div = document.createElement('div');
                    div.classList.add('mb-3');
                    const label = document.createElement('label');
                    label.setAttribute('for', fieldName);
                    label.classList.add('form-label');
                    label.textContent = `Champ ${index + 1}`;
                    const input = document.createElement('input');
                    input.setAttribute('type', 'text');
                    input.classList.add('form-control');
                    input.setAttribute('id', fieldName);
                    input.setAttribute('name', fieldName);
                    input.value = cell.textContent.trim();
                    input.required = true;
                    div.appendChild(label);
                    div.appendChild(input);
                    modalFields.appendChild(div);
                }
                index++;
            }

            const recordIdField = document.createElement('input');
            recordIdField.setAttribute('type', 'hidden');
            recordIdField.setAttribute('name', 'recordId');
            recordIdField.setAttribute('value', recordId);
            modalFields.appendChild(recordIdField);
        }

             


        function openDeleteModal(recordId) {
            const row = document.getElementById('row-' + recordId);
            const cells = row.getElementsByTagName('td');
            const recordData = [];

            let index = 0;
            for (const cell of cells) {
                if (index < cells.length - 1) {
                    recordData.push(cell.textContent.trim());
                }
                index++;
            }

            const message = `Êtes-vous sûr de vouloir supprimer l'enregistrement suivant ?<br><br><strong>${recordData.join(' | ')}</strong>`;
            const messageDiv = document.getElementById('deleteRecordMessage');
            messageDiv.innerHTML = message;

            const confirmDeleteButton = document.getElementById('confirmDeleteButton');
            confirmDeleteButton.onclick = function () {
                deleteRecord(recordId);
            };
        }

        function deleteRecord(recordId) {
            console.log("Suppression de l'enregistrement avec ID : " + recordId);
            // Appel AJAX ici si besoin
        }
    </script>
}
