﻿

  @model List<Dictionary<string, object>>
@{
    Layout = "~/Pages/Shared/_CRMLayout.cshtml";
    ViewData["Title"] = "Liste des Enregistrements";
    var entityName = ViewData["EntityName"] as string;
    var totalRecords = Model?.Count ?? 0;
    var totalColumns = Model?.FirstOrDefault()?.Count ?? 0;
    var nullCount = Model?.SelectMany(d => d.Values).Count(v => v == null) ?? 0;
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Enregistrements - @entityName</h1>

    <!-- Cartes récapitulatives -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total des Enregistrements</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@totalRecords</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Nombre de Colonnes</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@totalColumns</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Valeurs nulles détectées</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@nullCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bouton Retour + Export -->
    <div class="mb-3 d-flex justify-content-between">
        <a href="@Url.Action("GetEntities", "Crm")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour aux entités
        </a>
        <div>
            <button id="exportExcel" class="btn btn-outline-success me-2">
                <i class="fas fa-file-excel"></i> Export Excel
            </button>
            <button id="exportCSV" class="btn btn-outline-primary">
                <i class="fas fa-file-csv"></i> Export CSV
            </button>
        </div>
    </div>

    <!-- Formulaire d'ajout -->
    <div class="mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRecordModal">
            <i class="fas fa-plus"></i> Ajouter un Enregistrement
        </button>
    </div>

    <!-- Modal Ajouter un enregistrement -->
    <div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addRecordModalLabel">Ajouter un Enregistrement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Formulaire d'ajout -->
                    <form id="addRecordForm">
                        @foreach (var key in Model.First().Keys)
                        {
                            <div class="mb-3">
                                <label for="add_@key" class="form-label">@key</label>
                                <input type="text" class="form-control" id="add_@key" name="add_@key" required>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary">Ajouter</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Sélecteur de Colonnes avec Scroll -->
    <div class="mb-3">
        <label for="columnSelector" class="form-label fw-bold">Colonnes à afficher :</label>
        <select id="columnSelector" multiple class="form-select" style="height: 200px; overflow-y: scroll;">
            @if (Model.Any())
            {
                var index = 0;
                foreach (var key in Model.First().Keys)
                {
                    <option value="@index" selected>@key</option>
                    index++;
                }
            }
        </select>
    </div>

    <!-- Table -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive" style="overflow-x: auto;">
                <table class="table table-bordered" id="recordsTable" cellspacing="0">
                    <thead class="table-primary">
                        <tr>
                            @if (Model.Any())
                            {
                                foreach (var key in Model.First().Keys)
                                {
                                    <th>@key</th>
                                }
                            }
                            <th>Actions</th> <!-- Colonne pour les boutons -->
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr id="row-@row.Keys.First()">
                                @foreach (var value in row.Values)
                                {
                                    <td>
                                        @{
                                            string displayValue = "";

                                            if (value is Microsoft.Xrm.Sdk.Money money)
                                            {
                                                displayValue = money.Value.ToString("N2");
                                            }
                                            else if (value is Microsoft.Xrm.Sdk.OptionSetValue option)
                                            {
                                                displayValue = option.Value.ToString();
                                            }
                                            else if (value is Microsoft.Xrm.Sdk.EntityReference er)
                                            {
                                                displayValue = er.Name ?? er.Id.ToString();
                                            }
                                            else if (value is DateTime date)
                                            {
                                                displayValue = date.ToString("yyyy-MM-dd HH:mm");
                                            }
                                            else
                                            {
                                                displayValue = value?.ToString() ?? "";
                                            }
                                        }
                                        @displayValue
                                    </td>
                                }

                                <!-- Colonnes d'action pour la modification et la suppression -->
                                <td>
                                    <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#updateRecordModal"
                                            onclick="openEditModal('@row.Keys.First()')">
                                        <i class="fas fa-edit"></i> Modifier
                                    </button>
                                    <button class="btn btn-danger btn-sm"
                                            onclick="openDeleteModal('@row.Keys.First()')">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Modifier un enregistrement -->
<div class="modal fade" id="updateRecordModal" tabindex="-1" aria-labelledby="updateRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateRecordModalLabel">Modifier l'Enregistrement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateRecordForm">
                    <div id="modalFields"></div>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Supprimer un enregistrement -->
<div class="modal fade" id="deleteRecordModal" tabindex="-1" aria-labelledby="deleteRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteRecordModalLabel">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer cet enregistrement ?</p>
                <div id="deleteRecordMessage"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="confirmDeleteButton" class="btn btn-danger">Supprimer</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {

    <script>
            const entityName = '@ViewData["EntityName"]';
        console.log("Entity Name:", entityName);  // Vérifiez si entityName est bien défini
        //Export Excel
        document.getElementById("exportExcel").addEventListener("click", () => {
            const table = document.getElementById("recordsTable");
            const wb = XLSX.utils.table_to_book(table, { sheet: "Enregistrements" });
           
            XLSX.writeFile(wb, `${entityName}.xlsx`);
        });

        // Export CSV
        document.getElementById("exportCSV").addEventListener("click", () => {
            const table = document.getElementById("recordsTable");
            const wb = XLSX.utils.table_to_book(table, { sheet: "Enregistrements" });
              
            XLSX.writeFile(wb, `${entityName}.csv`);
        });



                // Fonction pour ouvrir le modal d'édition
        function openEditModal(recordId) {
            const row = document.getElementById('row-' + recordId);
            const modalFields = document.getElementById('modalFields');
            modalFields.innerHTML = ''; // Réinitialiser les champs du modal

            const cells = row.getElementsByTagName('td');
            const recordData = {};
            let index = 0;

            // Remplir les champs du modal avec les données de la ligne
            for (const cell of cells) {
                if (index < cells.length - 1) { // On ignore la dernière colonne (actions)
                    const fieldName = `field_${index}`;
                    recordData[fieldName] = cell.textContent.trim();

                    const div = document.createElement('div');
                    div.classList.add('mb-3');
                    const label = document.createElement('label');
                    label.setAttribute('for', fieldName);
                    label.classList.add('form-label');
                    label.textContent = `Champ ${index + 1}`;

                    const input = document.createElement('input');
                    input.setAttribute('type', 'text');
                    input.classList.add('form-control');
                    input.setAttribute('id', fieldName);
                    input.setAttribute('name', fieldName);
                    input.value = recordData[fieldName];
                    input.required = true;

                    div.appendChild(label);
                    div.appendChild(input);
                    modalFields.appendChild(div);
                }
                index++;
            }

            // Optionnel : gérer l'ID d'enregistrement pour une mise à jour spécifique
            const recordIdField = document.createElement('input');
            recordIdField.setAttribute('type', 'hidden');
            recordIdField.setAttribute('name', 'recordId');
            recordIdField.setAttribute('value', recordId);
            modalFields.appendChild(recordIdField);
        }

        // Fonction pour ouvrir le modal de suppression
        function openDeleteModal(recordId) {
            const row = document.getElementById('row-' + recordId);
            const cells = row.getElementsByTagName('td');
            const recordData = [];

            let index = 0;
            for (const cell of cells) {
                if (index < cells.length - 1) { // On ignore la dernière colonne (actions)
                    recordData.push(cell.textContent.trim());
                }
                index++;
            }

            // Afficher le message dans le modal
            const message = `Êtes-vous sûr de vouloir supprimer l'enregistrement suivant ?<br><br><strong>${recordData.join(' | ')}</strong>`;
            const messageDiv = document.getElementById('deleteRecordMessage');
            messageDiv.innerHTML = message;

            // Associer l'action de suppression à un bouton
            const confirmDeleteButton = document.getElementById('confirmDeleteButton');
            confirmDeleteButton.onclick = function () {
                // Logique de suppression ici, par exemple, via une requête AJAX
                deleteRecord(recordId);
            };
        }

        // Fonction pour supprimer un enregistrement (envoi de la requête de suppression)
        function deleteRecord(recordId) {
            // Par exemple, envoi d'une requête AJAX pour supprimer l'enregistrement
            fetch(`/deleteRecord/${recordId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ recordId })
            })
            .then(response => {
                if (response.ok) {
                    // Si la suppression est réussie, on retire la ligne de la table
                    const row = document.getElementById('row-' + recordId);
                    row.remove();
                    // Fermer le modal après suppression
                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteRecordModal'));
                    modal.hide();
                } else {
                    alert('Erreur lors de la suppression de l\'enregistrement.');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                alert('Erreur de communication avec le serveur.');
            });
        }

                document.getElementById("columnSelector").addEventListener("change", function () {
            const selectedIndexes = Array.from(this.selectedOptions).map(option => parseInt(option.value));
            const table = document.getElementById("recordsTable");

            // Parcourir toutes les lignes
            for (let row of table.rows) {
                for (let i = 0; i < row.cells.length - 1; i++) { // ignorer colonne "Actions"
                    row.cells[i].style.display = selectedIndexes.includes(i) ? '' : 'none';
                }
            }
        });
        

    </script>
  

}

