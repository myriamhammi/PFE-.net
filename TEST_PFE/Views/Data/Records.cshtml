@model List<Dictionary<string, object>>
@{
    ViewData["Title"] = "Liste des Enregistrements";
    Layout = "~/Pages/Shared/_CRMLayout.cshtml";
    var entityName = ViewData["EntityName"] ?? "";
    var idKey = entityName.ToString().ToLower() + "id";
    var allColumns = Model?.SelectMany(r => r.Keys).Distinct().ToList() ?? new List<string>();
    var totalRecords = Model?.Count ?? 0;
    var recentRecords = Model?.Where(r => r.ContainsKey("createdon")).Count() ?? 0;
    var modifiedRecords = Model?.Where(r => r.ContainsKey("modifiedon")).Count() ?? 0;
}

<style>
    .stats-card {
        transition: all 0.3s ease;
        border: none;
        border-radius: 15px;
        overflow: hidden;
        position: relative;
    }

        .stats-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .stats-card.primary::before {
            background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
        }

        .stats-card.success::before {
            background: linear-gradient(90deg, #43e97b 0%, #38f9d7 100%);
        }

        .stats-card.warning::before {
            background: linear-gradient(90deg, #fa709a 0%, #fee140 100%);
        }

        .stats-card.info::before {
            background: linear-gradient(90deg, #a8edea 0%, #fed6e3 100%);
        }

    .table-hover tbody tr:hover {
        background-color: rgba(255,230,0,0.05);
        transition: background-color 0.3s ease;
    }

    .fade-in {
        animation: fadeIn 0.6s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .filter-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        color: white;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .column-selector {
        background: rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 20px;
        backdrop-filter: blur(10px);
    }

    .column-checkbox {
        background: rgba(255,255,255,0.2);
        border-radius: 25px;
        padding: 8px 15px;
        margin: 5px;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .column-checkbox:hover {
            background: rgba(255,255,255,0.3);
            transform: translateY(-2px);
        }

        .column-checkbox input:checked + label {
            color: #fff;
            font-weight: 600;
        }

    .action-buttons .btn {
        transition: all 0.3s ease;
        border-radius: 10px;
    }

        .action-buttons .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .search-container {
        position: relative;
    }

        .search-container .form-control {
            border-radius: 25px;
            padding-left: 50px;
            border: 2px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.2);
            color: white;
            backdrop-filter: blur(10px);
        }

            .search-container .form-control::placeholder {
                color: rgba(255,255,255,0.8);
            }

        .search-container .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.8);
            z-index: 10;
        }

    .card-icon {
        font-size: 2.5rem;
        opacity: 0.8;
    }

    .gradient-text {
        background: linear-gradient(45deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>

<div class="container-fluid fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 gradient-text mb-1">@entityName</h1>
            <p class="text-muted mb-0">Gestion des enregistrements</p>
        </div>
        <div class="action-buttons">
            <a href="@Url.Action("GetEntities", "Crm")" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Retour
            </a>

            <button class="btn btn-outline-primary shadow-sm me-2 rounded" id="exportCSV">
                <i class="fas fa-file-csv"></i> Export CSV
            </button>
            <button class="btn btn-outline-success shadow-sm rounded" id="exportExcel">
                <i class="fas fa-file-excel"></i> Export Excel
            </button>

            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addRecordModal">
                <i class="fas fa-plus"></i> Nouvel enregistrement
            </button>
        </div>
    </div>

    <!-- Cartes statistiques améliorées -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card primary shadow h-100 py-3">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Enregistrements</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@totalRecords</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-database card-icon text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card success shadow h-100 py-3">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Colonnes Disponibles</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@allColumns.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-columns card-icon text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card warning shadow h-100 py-3">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Entité Active</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">@entityName</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-layer-group card-icon text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card info shadow h-100 py-3">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Statut</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">
                                <span class="badge bg-success">Actif</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle card-icon text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section de filtrage améliorée -->
    <div class="filter-section shadow-lg mb-4">
        <div class="row align-items-center">
            <div class="col-md-6 mb-3">
                <h5 class="text-white mb-3">
                    <i class="fas fa-search me-2"></i>Recherche et Filtres
                </h5>
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="form-control" id="searchInput" placeholder="Rechercher dans les enregistrements...">
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <h5 class="text-white mb-3">
                    <i class="fas fa-eye me-2"></i>Colonnes Visibles
                </h5>
                <div class="column-selector">
                    <div class="d-flex flex-wrap" id="columnCheckboxes">
                        @foreach (var col in allColumns)
                        {
                            <div class="column-checkbox">
                                <input class="form-check-input column-toggle" type="checkbox" id="col-@col" value="@col" checked />
                                <label class="form-check-label text-white ms-2" for="col-@col">@col</label>
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-outline-light btn-sm me-2" onclick="selectAllColumns()">
                            <i class="fas fa-check-double"></i> Tout sélectionner
                        </button>
                        <button class="btn btn-outline-light btn-sm" onclick="deselectAllColumns()">
                            <i class="fas fa-times"></i> Tout désélectionner
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table des enregistrements -->
    <div class="card shadow-lg mb-4 fade-in">
        <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <h6 class="m-0 font-weight-bold">
                <i class="fas fa-table me-2"></i>Liste des enregistrements
            </h6>
            <div class="d-flex align-items-center">
                <span class="badge bg-light text-dark">@totalRecords enregistrement(s)</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="recordsTable">
                    <thead style="background-color: #f8f9fa;">
                        <tr id="dynamicHeaders">
                            @foreach (var col in allColumns)
                            {
                                <th data-col="@col" class="text-center border-0 py-3">
                                    <i class="fas fa-sort me-1 text-muted"></i>@col
                                </th>
                            }
                            <th class="text-center border-0 py-3">
                                <i class="fas fa-cogs me-1 text-muted"></i>Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="@(allColumns.Count + 1)" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="fas fa-folder-open fa-4x text-muted mb-3"></i>
                                        <h5 class="text-muted">Aucun enregistrement trouvé</h5>
                                        <p class="text-muted mb-0">Commencez par ajouter votre premier enregistrement</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var record in Model)
                            {
                                <tr class="border-0">
                                    @foreach (var col in allColumns)
                                    {
                                        <td data-col="@col" class="align-middle py-3 border-0">
                                            @(record.ContainsKey(col) ? record[col] : "")
                                        </td>
                                    }
                                    <td class="text-center py-3 border-0">
                                        <div class="action-buttons">
                                            <a href="@Url.Action("GetRecordForUpdate", "Crm", new { entityName = entityName, id = (record.ContainsKey(idKey) ? record[idKey] : null) })"
                                               class="btn btn-warning btn-sm me-1" title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="@Url.Action("DeleteRecord", "Crm")" style="display:inline;"
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet enregistrement ?');">
                                                <input type="hidden" name="EntityName" value="@entityName" />
                                                <input type="hidden" name="Id" value="@(record.ContainsKey(idKey) ? record[idKey] : null)" />
                                                <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal d'ajout amélioré -->
<div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 20px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 20px 20px 0 0;">
                <h5 class="modal-title" id="addRecordModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Nouvel enregistrement
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("CreateRecord", "Crm")" class="needs-validation" novalidate>
                <div class="modal-body p-4">
                    <input type="hidden" name="EntityName" value="@entityName" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name-add" class="form-label fw-bold">
                                <i class="fas fa-user me-1"></i>Nom
                            </label>
                            <input type="text" class="form-control" id="name-add" name="Fields[name]" required style="border-radius: 10px;" />
                            <div class="invalid-feedback">Ce champ est requis</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="description-add" class="form-label fw-bold">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea class="form-control" id="description-add" name="Fields[description]" rows="3" style="border-radius: 10px;"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light" style="border-radius: 0 0 20px 20px;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: 10px;">
                        <i class="fas fa-times me-1"></i>Annuler
                    </button>
                    <button type="submit" class="btn btn-success" style="border-radius: 10px;">
                        <i class="fas fa-save me-2"></i>Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Gestion des colonnes
        const checkboxes = document.querySelectorAll('.column-toggle');
        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                const col = this.value;
                const checked = this.checked;
                document.querySelectorAll(`[data-col="${col}"]`).forEach(cell => {
                    cell.style.display = checked ? '' : 'none';
                });
            });
        });

        // Recherche en temps réel
        const searchInput = document.getElementById('searchInput');
        const table = document.getElementById('recordsTable');
        const rows = table.getElementsByTagName('tr');

        searchInput.addEventListener('keyup', function() {
            const searchText = this.value.toLowerCase();

            Array.from(rows).forEach((row, index) => {
                if(index === 0) return; // Skip header row
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchText) ? '' : 'none';
            });
        });

        // Validation du formulaire
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        });
    });

    // Fonctions pour sélectionner/désélectionner toutes les colonnes
    function selectAllColumns() {
        document.querySelectorAll('.column-toggle').forEach(cb => {
            cb.checked = true;
            cb.dispatchEvent(new Event('change'));
        });
    }

    function deselectAllColumns() {
        document.querySelectorAll('.column-toggle').forEach(cb => {
            cb.checked = false;
            cb.dispatchEvent(new Event('change'));
        });
    }


    //Export Excel
        const entityName = '@ViewData["EntityName"]';

        document.getElementById("exportExcel").addEventListener("click", () => {
            const table = document.getElementById("recordsTable");
            const wb = XLSX.utils.table_to_book(table, { sheet: "Enregistrements" });

            XLSX.writeFile(wb, `${entityName}.xlsx`);
        });

        // Export CSV
        document.getElementById("exportCSV").addEventListener("click", () => {
            const table = document.getElementById("recordsTable");
            const wb = XLSX.utils.table_to_book(table, { sheet: "Enregistrements" });

            XLSX.writeFile(wb, `${entityName}.csv`);
        });

</script>
<!-- Add Modal and other modals can be updated similarly if needed -->
<div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addRecordModalLabel">Ajouter un enregistrement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("CreateRecord", "Crm")">
                <div class="modal-body">
                    <input type="hidden" name="EntityName" value="@entityName" />
                    <div class="mb-3">
                        <label for="name-add" class="form-label">Nom</label>
                        <input type="text" class="form-control" id="name-add" name="Fields[name]" required />
                    </div>
                    <div class="mb-3">
                        <label for="description-add" class="form-label">Description</label>
                        <input type="text" class="form-control" id="description-add" name="Fields[description]" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success">Ajouter</button>
                </div>
            </form>
        </div>
    </div>
</div>
