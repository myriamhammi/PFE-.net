@model dynamic

@{
    ViewData["Title"] = "Créer un enregistrement";
}

<h2>@ViewData["Title"]</h2>

<form method="post" action="@Url.Action("CreateRecord", "Crm", new { entityName = Model.EntityName })">
    <div class="form-group">
        <label for="name">Nom</label>
        <input type="text" class="form-control" id="name" name="name" required />
    </div>

    <div class="form-group">
        <label for="createdon">Date de création</label>
        <input type="text" class="form-control" id="createdon" name="createdon" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Créer</button>
</form>
