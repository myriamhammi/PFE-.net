@model IEnumerable<string>
@{
    ViewData["Title"] = "Liste des Entités";
    Layout = "~/Pages/Shared/_CRMLayout.cshtml";
}

<div class="container-fluid">

    <!-- Titre -->
    <h1 class="h3 mb-4 text-gray-800 text-center">Liste des Entités</h1>

    <!-- Barre de recherche -->
    <div class="row mb-3">
        <div class="col-md-6 offset-md-3">
            <input type="text" class="form-control shadow-sm" id="entitySearchInput" placeholder="🔍 Rechercher une entité..." />
        </div>
    </div>

    <!-- Tableau des entités -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Entités disponibles</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="entitiesTable" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Nom de l'Entité</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted">Aucune entité disponible</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var entityName in Model)
                            {
                                <tr>
                                    <td>@entityName</td>
                                    <td class="text-center">
                                        <form action="@Url.Action("GetRecords", "Crm", new { entityName = entityName })" method="get" class="d-inline">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="fas fa-list"></i> Voir les enregistrements
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Script de recherche -->
<script>
    document.getElementById("entitySearchInput").addEventListener("keyup", function () {
        const filter = this.value.toLowerCase();
        const rows = document.querySelectorAll("#entitiesTable tbody tr");

        rows.forEach(row => {
            const entityName = row.cells[0].textContent.toLowerCase();
            row.style.display = entityName.includes(filter) ? "" : "none";
        });
    });
</script>
