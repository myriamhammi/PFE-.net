@model IEnumerable<string>
@{
    ViewData["Title"] = "Liste des Entités";
    Layout = "~/Pages/Shared/_CRMLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 mb-0 text-gray-800 text-center font-weight-bold">Liste des Entités</h1>
            <hr class="divider my-4" style="max-width: 150px; border-width: 2px; border-color: #4e73df; margin-left: auto; margin-right: auto;">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 offset-md-3">
            <div class="input-group shadow-sm">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-primary text-white border-0"><i class="fas fa-search"></i></span>
                </div>
                <input type="text" class="form-control border-0 py-4" id="entitySearchInput" placeholder="Rechercher une entité..." style="transition: all 0.3s ease;" />
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-lg mb-4" style="transition: all 0.3s ease;">
        <div class="card-header py-3 bg-gradient-primary">
            <h6 class="m-0 font-weight-bold text-white">Entités disponibles</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="entitiesTable" width="100%" cellspacing="0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 px-4 font-weight-bold">Nom de l'Entité</th>
                            <th class="py-3 px-4 text-center font-weight-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-database fa-3x mb-3 text-gray-300"></i>
                                        <p>Aucune entité disponible</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var entityName in Model)
                            {
                                <tr class="entity-row" style="transition: all 0.2s ease;">
                                    <td class="py-3 px-4 align-middle font-weight-medium">@entityName</td>
                                    <td class="py-3 px-4 text-center align-middle">
                                        <form action="@Url.Action("GetRecords", "Crm", new { entityName = entityName })" method="get" class="d-inline">
                                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                                <i class="fas fa-list mr-1"></i> Voir les enregistrements
                                            </button>
                                        </form>
                                        <form action="@Url.Action("CreateRecord", "Crm")" method="post" class="d-inline ml-2">
                                            <input type="hidden" name="EntityName" value="@entityName" />
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                                                <i class="fas fa-plus mr-1"></i> Ajouter
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .entity-row:hover {
        background-color: rgba(78, 115, 223, 0.05);
        transform: translateY(-2px);
    }

    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .divider {
        transition: width 0.6s ease;
    }

    #entitySearchInput:focus {
        box-shadow: 0 0 15px rgba(78, 115, 223, 0.25);
    }
</style>

<script>
    document.getElementById("entitySearchInput").addEventListener("keyup", function () {
        const filter = this.value.toLowerCase();
        const rows = document.querySelectorAll("#entitiesTable tbody tr.entity-row");
        let hasResults = false;

        rows.forEach(row => {
            const entityName = row.cells[0].textContent.toLowerCase();
            const matches = entityName.includes(filter);
            row.style.display = matches ? "" : "none";
            if (matches) hasResults = true;
        });

        // Show no results message if needed
        const noResultsRow = document.querySelector("#entitiesTable tbody tr:not(.entity-row)");
        if (noResultsRow) {
            noResultsRow.style.display = hasResults ? "none" : "";
        }
    });

    // Add subtle animation when page loads
    document.addEventListener("DOMContentLoaded", function() {
        const rows = document.querySelectorAll(".entity-row");
        rows.forEach((row, index) => {
            row.style.opacity = "0";
            row.style.transform = "translateY(10px)";
            setTimeout(() => {
                row.style.transition = "opacity 0.3s ease, transform 0.3s ease";
                row.style.opacity = "1";
                row.style.transform = "translateY(0)";
            }, 100 + (index * 50));
        });
    });
</script>
