@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BI 360°</title>

    <!-- Favicon -->
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" />

    <style>
        /* Couleurs principales */
        :root {
            --ey-yellow: #F2C100;
            --ey-black: #000000;
            --ey-light-gray: #D1D3D4;
            --ey-dark-gray: #4B4F54;
            --ey-white: #FFFFFF;
            --ey-blue: #003B5C;
            --ey-green: #009639;
            --ey-orange: #F47C00;
        }

        /* Corps de texte */
        body {
            font-family: 'Arial', sans-serif;
            color: var(--ey-dark-gray);
            background-color: var(--ey-white);
        }

        /* Titres */
        h1, h2, h3 {
            color: var(--ey-black);
        }

        /* Liens */
        a {
            color: var(--ey-blue);
        }

            a:hover {
                color: var(--ey-orange);
            }

        /* Boutons */
        .btn-primary {
            background-color: var(--ey-yellow);
            color: var(--ey-black);
        }

            .btn-primary:hover {
                background-color: var(--ey-orange);
            }

        /* Zones de texte */
        .card {
            background-color: var(--ey-light-gray);
            border: 1px solid var(--ey-dark-gray);
        }

        .card-title {
            color: var(--ey-black);
            font-weight: bold;
        }

        /* Bordures, fond */
        section.bg-light {
            background-color: var(--ey-light-gray);
        }

        footer {
            background-color: var(--ey-dark-gray);
            color: var(--ey-white);
        }
        /* Navbar styling */
        #navbar {
            background-color: #1e1e28; /* Fond sombre */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3); /* Ombre subtile */
            transition: all 0.3s ease; /* Transition douce */
            border-bottom: 3px solid #ffe600; /* Bordure jaune */
        }

            /* Liens dans la navbar */
            #navbar .nav-link {
                position: relative;
                padding: 0.5rem 0.8rem;
                margin: 0 0.2rem;
                font-weight: 500;
            }

                /* Effet de survol pour les liens */
                #navbar .nav-link:hover {
                    color: #ffe600 !important;
                    transform: translateY(-2px);
                }

                /* Effet de ligne sous les liens au survol */
                #navbar .nav-link::after {
                    content: '';
                    position: absolute;
                    width: 0;
                    height: 2px;
                    bottom: 0;
                    left: 50%;
                    background-color: #ffe600;
                    transition: all 0.3s ease;
                    transform: translateX(-50%);
                }

                #navbar .nav-link:hover::after {
                    width: 80%;
                }

        /* Style pour les éléments du dropdown */
        .dropdown-menu {
            margin-top: 10px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .dropdown-item {
            padding: 10px 20px;
            transition: all 0.2s;
        }

            .dropdown-item:hover {
                background-color: #333333;
                color: #ffe600 !important;
                transform: translateX(5px);
            }

        /* Effet de survol pour le bouton utilisateur */
        #navbar .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(255, 230, 0, 0.3);
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            width: 100%;
        }

        main {
            min-height: 100vh; /* S'étend sur toute la hauteur visible */
            width: 100%;
        }

    </style>
</head>

<body>
    <!-- NAVBAR -->
    <nav id="navbar" class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/">
                <span style="color: #ffe600;">BI</span> <span style="color: #ffffff;">360°</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item px-2">
                        <a class="nav-link" href="/" style="color: #ffffff; transition: all 0.3s;">
                            <i class="fas fa-home me-1" style="color: #ffe600;"></i> Accueil
                        </a>
                    </li>
                    <li class="nav-item  px-2">
                        <a class="nav-link" href="SalesKPI/Predictifs" style="color: #ffffff; transition: all 0.3s;">
                            <i class="fas fa-chart-line me-1" style="color: #ffe600;"></i> KPIs
                        </a>
                        
                    </li>
                    <li class="nav-item px-2">
                        <a class="nav-link" href="#etl" style="color: #ffffff; transition: all 0.3s;">
                            <i class="fas fa-database me-1" style="color: #ffe600;"></i> ETL
                        </a>
                    </li>
                    <li class="nav-item px-2">
                        <a class="nav-link" href="#crm" style="color: #ffffff; transition: all 0.3s;">
                            <i class="fas fa-users me-1" style="color: #ffe600;"></i> CRM
                        </a>
                    </li>
                  
                </ul>
                <a href="#" class="btn ms-4" style="background-color: #ffe600; color: #1e1e28; font-weight: bold; border-radius: 30px; padding: 8px 20px; transition: all 0.3s;">
                    <i class="fas fa-user me-1"></i> Myriam HAMMI
                </a>
            </div>
        </div>
    </nav>

    <!-- MAIN -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer py-4" style="background-color: #1e1e28; color: #ffffff; border-top: 3px solid #ffe600;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 text-lg-start">
                    <div class="mb-2">
                        <span style="color: #ffe600; font-weight: bold; font-size: 1.5rem;">BI</span>
                        <span style="color: #ffffff; font-weight: bold; font-size: 1.5rem;">360°</span>
                    </div>
                    <div style="color: #cccccc;">Copyright &copy; BI 360° 2023</div>
                </div>
                <div class="col-lg-4 my-3 my-lg-0 text-center">
                    <a class="btn mx-2" href="#!" aria-label="Twitter" style="background-color: #333333; color: #ffe600; border-radius: 50%; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.3s;">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a class="btn mx-2" href="#!" aria-label="Facebook" style="background-color: #333333; color: #ffe600; border-radius: 50%; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.3s;">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a class="btn mx-2" href="#!" aria-label="LinkedIn" style="background-color: #333333; color: #ffe600; border-radius: 50%; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.3s;">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="text-decoration-none me-3" href="#!" style="color: #cccccc; transition: all 0.3s;">Politique de confidentialité</a>
                    <a class="text-decoration-none" href="#!" style="color: #cccccc; transition: all 0.3s;">Conditions d'utilisation</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Effet de défilement pour la navbar
            window.onscroll = function() {
                var navbar = document.getElementById('navbar');
                if (window.scrollY > 50) {
                    navbar.style.padding = '8px 0';
                    navbar.style.boxShadow = '0 5px 20px rgba(0, 0, 0, 0.4)';
                } else {
                    navbar.style.padding = '15px 0';
                    navbar.style.boxShadow = '0 4px 10px rgba(0, 0, 0, 0.3)';
                }
            };

            // Animation des liens de la navbar
            const navLinks = document.querySelectorAll('#navbar .nav-link');
            navLinks.forEach((link, index) => {
                setTimeout(() => {
                    link.style.opacity = '0';
                    link.style.transform = 'translateY(-20px)';
                    setTimeout(() => {
                        link.style.transition = 'all 0.5s ease';
                        link.style.opacity = '1';
                        link.style.transform = 'translateY(0)';
                    }, 100);
                }, index * 100);
            });

            // Animation du bouton utilisateur
            const userBtn = document.querySelector('#navbar .btn');
            if (userBtn) {
                setTimeout(() => {
                    userBtn.style.opacity = '0';
                    userBtn.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        userBtn.style.transition = 'all 0.5s ease';
                        userBtn.style.opacity = '1';
                        userBtn.style.transform = 'scale(1)';
                    }, 100);
                }, navLinks.length * 100 + 200);
            }

            // Animation du logo
            const brand = document.querySelector('#navbar .navbar-brand');
            if (brand) {
                brand.style.opacity = '0';
                brand.style.transform = 'translateX(-20px)';
                setTimeout(() => {
                    brand.style.transition = 'all 0.5s ease';
                    brand.style.opacity = '1';
                    brand.style.transform = 'translateX(0)';
                }, 100);
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
