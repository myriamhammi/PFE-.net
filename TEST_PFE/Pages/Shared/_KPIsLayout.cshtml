@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sales Process CRM</title>

    <!-- Favicon -->
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />

    <!-- Fonts -->
       <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />


    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- CSS (Agency + SB Admin 2) -->
    <link href="~/css/sb-admin-2/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/css/styles.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />




    <style>
        header {
            position: relative;
            overflow: hidden;
        }

        #particles-js {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0; /* derrière tout le contenu */
        }

        header .container,
        header .row,
        header .col-lg-6,
        header .text-center {
            position: relative;
            z-index: 1; /* au-dessus des particules */
        }
        /* S'assure que le body et html occupent toute la hauteur de la fenêtre */
html, body {
    height: 100%;
    margin: 0;
    font-family: 'Poppins', sans-serif;
}

/* Gère la hauteur du contenu principal */
main {
    min-height: 100vh; /* Utilise 100% de la hauteur de l'écran */
    padding-top: 80px; /* Décale le contenu sous la navbar */
    padding-bottom: 40px; /* Laisse de l'espace pour le footer */
}

/* S'assurer que le footer est en bas de la page */
footer {
    position: relative;
    bottom: 0;
    width: 100%;
}

    </style>
</head>
<body id="page-top">
    <!-- Navbar moderne et interactive -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top py-3">
        <div class="container px-5">
            <a class="navbar-brand fw-bold fs-4" href="#">BI 360°</a>
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent"
                    aria-controls="navbarContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item px-2">
                        <a class="nav-link text-light nav-hover" href="/">Accueil</a>
                    </li>

                    <!-- Menu déroulant KPIs -->
                    <li class="nav-item dropdown px-2">
                        <a class="nav-link dropdown-toggle text-light nav-hover" href="#" id="navbarDropdownKpis"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            KPIs
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="navbarDropdownKpis">
                           <li><a class="dropdown-item" asp-controller="SalesKPI" asp-action="Descriptifs">Descriptifs</a></li>
                           <li><a class="dropdown-item" asp-controller="SalesKPI" asp-action="Explicatifs">Explicatifs</a></li>
                           <li><a class="dropdown-item" asp-controller="SalesKPI" asp-action="Predictifs">Prédictifs</a></li>
                        </ul>
                    </li>

                    <li class="nav-item px-2">
                        <a class="nav-link text-light nav-hover" href="#etl">Système ETL</a>
                    </li>
                    <li class="nav-item px-2">
                        <a class="nav-link text-light nav-hover" href="#crm">CRM</a>
                    </li>
                    <li class="nav-item px-2">
                        <a class="nav-link text-light nav-hover" href="#team">Notre équipe</a>
                    </li>
                </ul>

                <!-- Call-to-action -->
                <a href="#login" class="btn btn-warning ms-4 fw-bold shadow-sm">Se connecter</a>
            </div>
        </div>
    </nav>


    <!-- MAIN CONTENT -->
    <main role="main" class="pt-5 mt-5">
        @RenderBody()
    </main>

    <!-- FOOTER -->
<footer class="footer py-4" style="background-color: #333333; color: white;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-4 text-lg-start">Copyright &copy; Your Website 2023</div>
            <div class="col-lg-4 my-3 my-lg-0">
                <a class="btn btn-light btn-social mx-2" href="#!" aria-label="Twitter"><i class="fab fa-twitter text-dark"></i></a>
                <a class="btn btn-light btn-social mx-2" href="#!" aria-label="Facebook"><i class="fab fa-facebook-f text-dark"></i></a>
                <a class="btn btn-light btn-social mx-2" href="#!" aria-label="LinkedIn"><i class="fab fa-linkedin-in text-dark"></i></a>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a class="link-light text-decoration-none me-3" href="#!">Privacy Policy</a>
                <a class="link-light text-decoration-none" href="#!">Terms of Use</a>
            </div>
        </div>
    </div>
</footer>


    <!-- JS SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/sb-admin-2/sb-admin-2.min.js"></script>
    <script src="~/js/scripts.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
