<div id="assistant-box" class="assistant">
    <p id="assistant-message">Bonjour 👋 ! Que souhaitez-vous faire aujourd’hui ?</p>
    <button onclick="sendOption('Rapports')">📊 Consulter mes rapports</button>
    <button onclick="sendOption('Analyser')">🧠 Analyser mes données</button>
    <button onclick="sendOption('Alertes')">🚨 Voir les alertes</button>
</div>

<div id="assistant-response" class="response"></div>

@section Scripts {
    <script>
        function sendOption(option) {
            fetch('/api/assistant/respond', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ choice: option })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('assistant-response').innerText = data.response;
            });
        }
    </script>
}
